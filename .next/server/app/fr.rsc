15:["$","$L19",null,{"formats":"$undefined","locale":"fr","messages":{"public":{"header":{"home":"Accueil","manual":"Manuel","about":"À propos","training":"Formations","openApp":"Ouvrir l'application","menu":"Menu","back":"Retour"},"footer":{"resources":"Ressources","manual":"Manuel utilisateur","about":"À propos","training":"Formations","glossary":"Glossaire","teachers":"Enseignants","legalTitle":"Légal","legalMentions":"Mentions légales","terms":"Conditions d'utilisation","privacy":"Politique de confidentialité","license":"Licence AGPL v3","contact":"Contact","reportIssue":"Signaler un problème","copyright":"© {year} Studomate","createdBy":"Créé par","slogan":"Créer, Simuler, Automatiser"}},"common":{"languageSwitch":{"label":"Langue","fr":"Français","en":"English"},"modal":{"close":"Fermer"}},"auth":{"accountStatus":{"tooltip":"Connectez-vous pour associer vos projets à votre compte","signIn":"Se connecter","signOut":"Se déconnecter"},"titles":{"signIn":"Se connecter","signUp":"Créer un compte","resetPassword":"Mot de passe oublié"},"modeSelector":{"pseudo":"Pseudo","email":"Email","anonymous":"Anonyme","withEmail":"Avec email"},"fields":{"pseudo":"Pseudo","email":"Email","password":"Mot de passe","pseudoHelper":"Votre identifiant public. Doit être unique."},"signIn":{"submit":"Se connecter","forgotPassword":"Mot de passe oublié ?","noAccount":"Pas de compte ? En créer un"},"forgottenPseudoPassword":{"title":"Mot de passe oublié","body":"Un compte créé avec un pseudo n'a pas d'adresse email : nous ne pouvons pas vous envoyer de lien de réinitialisation. Contactez-nous en indiquant votre pseudo, nous vous aiderons à récupérer l'accès à votre compte.","contact":"Nous contacter","close":"Fermer"},"signUp":{"submit":"Créer le compte","haveAccount":"Déjà un compte ? Se connecter","anonymousNotice":"Aucune donnée personnelle n'est collectée en mode anonyme. En contrepartie, la récupération du mot de passe est impossible si vous l'oubliez."},"resetPassword":{"intro":"Entrez votre adresse email. Vous recevrez un lien pour réinitialiser votre mot de passe.","submit":"Envoyer le lien","backToSignIn":"Retour à la connexion","emailSent":"Un email de réinitialisation a été envoyé. Vérifiez votre boîte mail."},"errors":{"invalidCredentials":"Email ou mot de passe incorrect.","invalidPseudoCredentials":"Pseudo ou mot de passe incorrect.","emailAlreadyExists":"Un compte existe déjà avec cette adresse email.","pseudoTaken":"Ce pseudo est déjà utilisé. Choisissez-en un autre.","emailNotConfirmed":"Votre adresse email n'a pas encore été confirmée. Vérifiez votre boîte mail.","rateLimit":"Trop de tentatives. Veuillez patienter quelques minutes avant de réessayer.","weakPassword":"Mot de passe trop faible. Utilisez au moins 8 caractères.","invalidEmail":"Adresse email invalide.","network":"Impossible de contacter le serveur. Vérifiez votre connexion.","signInFailed":"Connexion impossible. Vérifiez vos identifiants.","signUpFailed":"Création de compte impossible. Veuillez réessayer.","wrongPassword":"Mot de passe incorrect.","repatriationFailed":"Impossible de rapatrier vos projets cloud en local. Votre compte n'a pas été supprimé.","deleteAccountFailed":"La suppression du compte a échoué. Veuillez réessayer."},"cloudAccount":{"title":"Compte Cloud","projectCount":"{count, plural, one {# projet dans le cloud} other {# projets dans le cloud}}","projectCountLoading":"Chargement des projets…","openProject":"Ouvrir un projet","signOut":"Se déconnecter","deleteAccount":"Supprimer mon compte"},"deleteAccount":{"title":"Supprimer mon compte","warning":"Cette action est définitive : votre compte, votre profil et votre progression de formation seront supprimés. Les liens de partage de vos projets cesseront de fonctionner.","repatriation":"{count, plural, one {Votre projet cloud sera rapatrié} other {Vos # projets cloud seront rapatriés}} en local dans ce navigateur avant la suppression.","noCloudProjects":"Vos projets locaux ne sont pas concernés.","passwordLabel":"Confirmez avec votre mot de passe","confirm":"Supprimer définitivement","cancel":"Annuler","deleted":"Votre compte a été supprimé."}},"profile":{"prompt":{"userTypeTitle":"Vous utilisez Studomate en tant que…","userTypeHint":"Facultatif, pour mieux connaître les utilisateurs de l'application.","schoolTypeTitle":"Une dernière question","schoolTypeQuestion":"Dans quel type d'établissement étudiez-vous ?","skip":"Passer"},"fields":{"userType":"Vous utilisez Studomate en tant que","schoolType":"Type d'établissement","notProvided":"Non renseigné"},"userTypes":{"student":"Étudiant","teacher":"Enseignant / formateur","professional":"Professionnel de l'automatisme","self_learner":"Autodidacte / curieux","other":"Autre"},"schoolTypes":{"high_school":"Lycée","bts":"BTS","iut":"IUT / BUT","university":"Université","engineering_school":"École d'ingénieurs","other":"Autre"}},"whatsNew":{"title":"Nouveautés de Studomate {version}","previous":"Précédent","next":"Suivant","done":"Compris","slides":{"grafcetEditor":{"title":"L'éditeur GRAFCET devient plus intelligent","body":"Déposez ou déplacez une étape, une transition, une action ou un renvoi à côté d'un élément compatible : la liaison se crée toute seule et l'élément se recale. En déplaçant une étape ou une transition, ses actions et ses renvois alignés l'accompagnent."},"actionChains":{"title":"Chaînez les actions d'une étape","body":"Une action a maintenant un point de connexion à droite : reliez-la à l'action suivante pour former une chaîne étape → action → action. Une nouvelle action se chaîne toute seule derrière la précédente, et une action déplacée emmène la suite de sa chaîne. Si vous supprimez l'étape, la chaîne reste soudée : reliez sa première action à une autre étape pour tout rattacher."},"scene3dDisplay":{"title":"La scène 3D s'affiche où vous voulez","body":"Affichez la scène 3D dans un panneau à droite des éditeurs, pour suivre le grafcet et la partie opérative côte à côte, par exemple en projection. Vous pouvez aussi l'ouvrir dans un cadre flottant que vous déplacez et redimensionnez comme une fenêtre, dans une page de l'éditeur ou dans un onglet du navigateur. Le menu Affichage et le bouton « Scène 3D » de la barre d'état ouvrent la scène dans le mode choisi."}}}},"now":"$undefined","timeZone":"UTC","children":["$L1a","$L1b"]}]
18:["$","$L19",null,{"formats":"$undefined","locale":"fr","messages":{"public":{"landing":{"heroTitle":"Apprenez le GRAFCET<br></br>et le Ladder en simulant","heroTagline":"Concevez, simulez et testez vos automatismes avec des HMI animées, directement dans le navigateur.","heroBadges":"Gratuit et open source · Sans installation · Sans compte · Aucune donnée personnelle","heroSceneLabel":"Animation 3D d'un poste de tri de caisses : un tapis amène chaque caisse, des vérins la trient selon sa hauteur.","followTraining":"Suivre la formation","showcaseGrafcetAlt":"L'éditeur Studomate en cours de simulation d'un GRAFCET","showcaseLadderAlt":"L'éditeur Studomate en cours de simulation d'un Ladder","showcaseHmiAlt":"L'éditeur d'interface HMI de Studomate","demoTitle":"Voir Studomate en action","demoVideoLabel":"Démonstration de la création et de la simulation d'un projet avec Studomate","demoVideoPause":"Mettre la démonstration en pause","demoVideoPlay":"Lire la démonstration","logicTitle":"Écrivez la logique","logicIntro":"GRAFCET et Ladder dans le même projet, avec des variables partagées.","machineTitle":"Pilotez la machine","machineIntro":"Reliez votre programme à une HMI, à une scène 3D ou à une vraie carte Arduino.","showcaseGrafcetTitle":"GRAFCET","showcaseGrafcetText":"Dessinez étapes, transitions et divergences, puis suivez l'évolution du grafcet en simulation : étapes actives, réceptivités vraies, actions en cours.","showcaseLadderTitle":"Ladder","showcaseLadderText":"Construisez vos réseaux avec contacts, bobines, temporisations et compteurs, et voyez le courant circuler pendant la simulation.","showcaseHmiTitle":"HMI","showcaseHmiText":"Composez des pages de supervision animées (voyants, boutons, réservoirs, objets mobiles) reliées aux mêmes variables que vos programmes.","showcaseScene3dTitle":"Scènes 3D","showcaseScene3dText":"Reliez votre programme à une partie opérative virtuelle en 3D (tapis, vérins, capteurs) et regardez la machine réagir en temps réel.","showcaseScene3dAlt":"Scène 3D d'un poste de tri de caisses piloté par Studomate","showcaseArduinoTitle":"Arduino","showcaseArduinoText":"Chargez votre programme sur une vraie carte Arduino Uno R3, ou utilisez ses entrées et sorties pendant la simulation, depuis Chrome ou Edge.","showcaseArduinoAlt":"Carte Arduino Uno R3","whyTitle":"Pourquoi Studomate ?","whyIntro":"La raison d'être de Studomate est de réduire à presque zéro la friction pour apprendre l'automatisme.","reasonFrictionTitle":"Friction zéro","reasonFrictionText":"Pas d'installation, pas de licence, pas d'automate ni de cartes d'E/S à configurer. On se concentre sur la logique, pas sur l'outil.","reasonAllInOneTitle":"Tout-en-un","reasonAllInOneText":"GRAFCET, Ladder et HMI animées dans le même environnement, avec des variables partagées entre les trois. Aucun outil gratuit ne combine les trois.","reasonShortLoopTitle":"Boucle de correction courte","reasonShortLoopText":"Les erreurs sont signalées pendant l'édition, pas seulement au lancement de la simulation. Un droit à l'erreur rapide et visuel.","audienceStudents":"Étudiants (BTS, IUT, écoles d'ingénieurs, universités)","audienceTeachers":"Enseignants et formateurs en automatisme / électrotechnique","audienceProfessionals":"Professionnels en reconversion ou remise à niveau","featureSimulationTitle":"Simulation temps réel","featureSimulationText":"Exécution pas-à-pas ou continue, avec visualisation des états, transitions et variables en direct.","featureManualTitle":"Manuel intégré","featureManualText":"Une aide complète accessible directement depuis l'application.","featureCloudTitle":"Comptes & cloud (optionnel)","featureCloudText":"Projets stockés localement ou dans le cloud, avec partage par lien.","stepsTitle":"Démarrez en 30 secondes","step1Title":"Ouvrez l'application","step1Text":"Rien à installer, tout se passe dans le navigateur.","step2Title":"Créez un projet ou partez d'un exemple","step2Text":"Démarrez de zéro ou ouvrez l'un des templates prêts à l'emploi.","step3Title":"Analysez, puis simulez","step3Text":"Vérifiez la structure, puis exécutez la logique et observez le système réagir.","trainingTitle":"Apprenez l'automatisme avec Studomate","trainingIntro":"Des modules guidés pour maîtriser le GRAFCET, puis le Ladder, avec des exercices à simuler dans l'application.","trainingA0LinkLabel":"Les bases de l'automatisme","trainingA0Topic":"Prérequis","trainingA0Summary":"Automatisme, variables, logique de base et cycle de scrutation.","trainingA1LinkLabel":"Les bases du GRAFCET","trainingA1Topic":"GRAFCET","trainingA1Summary":"Étapes, transitions, actions, divergences en OU et en ET.","trainingA2LinkLabel":"Ladder : logique et mémoire","trainingA2Topic":"Ladder","trainingA2Summary":"Contacts, bobines, auto-maintien, bobines S/R et fronts.","trainingA3LinkLabel":"Ladder : temps, comptage et calcul","trainingA3Topic":"Ladder","trainingA3Summary":"Temporisations, compteurs, calcul et sous-programmes.","trainingA4LinkLabel":"Du GRAFCET au Ladder (partie 1)","trainingA4Topic":"GRAFCET → Ladder","trainingA4Summary":"Implanter un GRAFCET en Ladder : un réseau par transition, deux programmes, actions, temps et défauts.","trainingA5LinkLabel":"Du GRAFCET au Ladder (partie 2)","trainingA5Topic":"GRAFCET → Ladder (suite)","trainingA5Summary":"Divergences en OU et en ET, arrêts d'une séquence, limites d'un réseau par transition et méthode en trois blocs.","trainingCta":"Voir toutes les formations","templatesTitle":"Des exemples pour démarrer","templatesIntro":"Ouvrez un projet pré-configuré et explorez-le à votre rythme.","templatePreviewAlt":"Aperçu du projet {label}","openInApp":"Ouvrir dans l'application","durabilityTitle":"Vos projets vous appartiennent","durabilityNoLockInTitle":"Aucun enfermement","durabilityNoLockInText":"Vos projets sont des fichiers que vous exportez et conservez. Le schéma est versionné : un projet exporté aujourd'hui restera ouvrable après les mises à jour de l'outil.","durabilityIndependenceTitle":"Vous ne dépendez de personne","durabilityIndependenceText":"Le code est libre sous licence AGPL v3 : si le projet s'arrête, il peut être repris ou auto-hébergé.","privacyTitle":"Pensé pour la vie privée","privacyText":"Aucun email requis, aucune donnée personnelle stockée, aucun cookie de suivi. L'authentification se fait par pseudo, et les statistiques d'usage sont anonymes.","sourceCodeText":"Le code source est public : lisez-le, signalez un problème ou contribuez.","viewOnGitHub":"Voir sur GitHub","openApp":"Ouvrir l'application"}},"templates":{"traffic-light":{"label":"Feu tricolore","description":"3 sorties booléennes (rouge, orange, vert) + interface HMI avec voyants colorés. À programmer."},"crossroads":{"label":"Carrefour de feux tricolores","description":"12 sorties booléennes (rouge/orange/vert × 4 feux : NS1, NS2, EO1, EO2) + interface HMI avec carrefour. Partie opérative simulée par la scène 3D. À programmer."},"drilling":{"label":"Poste de perçage","description":"Cycle séquentiel piloté par capteurs de fin de course : appui départ, descente, perçage temporisé, remontée. Pupitre et partie opérative simulés par la scène 3D. À programmer."},"elevator":{"label":"Ascenseur","description":"Ascenseur 3 niveaux : boutons d'appel palier et de cabine, afficheur d'étage et voyants dans la scène 3D qui simule la partie opérative. À programmer."},"parking":{"label":"Parking à barrière","description":"Deux barrières (entrée et sortie) et un compteur de places : détecteurs de voiture en attente, cellule sous la barrière, voyant « complet » et compteur dans la scène 3D, où les boutons Arrivée et Sortie font apparaître des voitures. À programmer."},"carton-sorting":{"label":"Poste de tri de caisses","description":"Tri de caisses par hauteur : détection au poste, aiguillage par trois vérins vers deux tapis de sortie, comptage. Partie opérative simulée par la scène 3D. À programmer."},"linear-sequence":{"label":"Séquence linéaire","description":"GRAFCET à 4 étapes, une seule chaîne, sans temporisation ni divergence. Mini-exercice du module Formations."},"and-divergence":{"label":"Divergence en ET","description":"Une divergence en ET refermée par sa convergence, deux branches parallèles. Mini-exercice du module Formations."},"or-divergence":{"label":"Divergence en OU","description":"Une divergence en OU à deux branches exclusives, chacune rebouclant seule vers l'état initial. Mini-exercice du module Formations."},"timer-cycle":{"label":"Temporisation","description":"GRAFCET à 2 étapes qui alternent selon deux temporisations, sans entrée. Observation du module Formations."},"ladder-and-or":{"label":"Contacts en série et en parallèle","description":"Deux réseaux fournis : manipuler a et b en simulation pour observer ET et OU. Mini-exercice du module Formations."},"ladder-reading":{"label":"Lire un programme Ladder","description":"Quatre réseaux combinatoires fournis : prédire les sorties puis vérifier en simulation. Mini-exercice du module Formations."},"ladder-logic":{"label":"Éclairage en va-et-vient","description":"Logique combinatoire : deux interrupteurs et une validation. Mini-exercice du module Formations."},"ladder-self-holding":{"label":"Pompe : auto-maintien","description":"Marche par bouton poussoir, arrêt prioritaire, auto-maintien. Mini-exercice du module Formations."},"ladder-interlock":{"label":"Moteur deux sens","description":"Deux auto-maintiens verrouillés entre eux, arrêt commun. Mini-exercice du module Formations."},"ladder-memory":{"label":"Pompe : défaut mémorisé","description":"Relais thermique, voyant de défaut mémorisé, acquittement sans redémarrage automatique. Mini-exercice du module Formations."},"ladder-edges-reading":{"label":"Lire les fronts","description":"Une même entrée sur un contact NO, P et N : relever le chronogramme. Mini-exercice du module Formations."},"ladder-toggle":{"label":"Télérupteur","description":"Un bouton allume puis éteint une lampe : ordre d'exécution des réseaux et contact P. Mini-exercice du module Formations."},"ladder-gate":{"label":"Portail motorisé","description":"Deux sens verrouillés, fins de course, arrêt, cellule. L'élève déclare les entrées. Épreuve de synthèse du module Formations."},"ladder-timers-reading":{"label":"Lire les temporisations","description":"Un TON, un TOF et un TP sur la même entrée : tracer les chronogrammes. Mini-exercice du module Formations."},"ladder-timers":{"label":"Démarrage étoile-triangle","description":"Étoile puis triangle par un TON, ventilateur prolongé par un TOF, clignotant à deux TON. Mini-exercice du module Formations."},"ladder-counters":{"label":"Comptage","description":"Comptage de pièces (CTU), zone tampon (CTUD), stock (CTD). Mini-exercice du module Formations."},"ladder-tank":{"label":"Cuve","description":"Hystérésis de niveau, alarme, compteur de démarrages par contact P. Mini-exercice du module Formations."},"ladder-scaling":{"label":"Mise à l'échelle","description":"Calcul du niveau à partir d'une valeur brute : dépassement, troncature, calcul en REAL. Mini-exercice du module Formations."},"ladder-subprograms":{"label":"Sous-programmes","description":"Appeler le sous-programme de comptage depuis le Main, et constater l'effet d'un appel conditionnel. Mini-exercice du module Formations."},"ladder-packing":{"label":"Mise en caisse","description":"Convoyeur, défaut, comptage et changement de caisse en sous-programmes. Aucune variable fournie. Épreuve de synthèse du module Formations."},"linear-sequence-naive-ladder":{"label":"Séquence linéaire : méthode des manuels","description":"GRAFCET linéaire implanté avec un auto-maintien par étape : observer le chevauchement. Mini-exercice du module Formations."},"linear-sequence-ladder":{"label":"Séquence linéaire en Ladder","description":"Implanter un GRAFCET linéaire en Ladder, un réseau par transition. Mini-exercice du module Formations."},"drilling-ladder":{"label":"Poste de perçage en Ladder","description":"GRAFCET de perçage en Ladder, temporisation et surveillance de la descente. Épreuve de synthèse du module Formations."},"or-divergence-ladder":{"label":"Divergence en OU en Ladder","description":"Une divergence en OU implantée en Ladder. Mini-exercice du module Formations."},"and-divergence-ladder":{"label":"Divergence en ET en Ladder","description":"Une divergence en ET implantée en Ladder. Mini-exercice du module Formations."},"traffic-light-ladder":{"label":"Feu tricolore en Ladder","description":"Feu tricolore en Ladder avec réinitialisation et arrêt en fin de cycle. Mini-exercice du module Formations."},"parking-ladder":{"label":"Parking en Ladder","description":"Commande du parking en Ladder, signalisation fournie, réinitialisation. Épreuve de synthèse du module Formations."},"gate-per-transition-ladder":{"label":"Portail à télécommande : un réseau par transition","description":"Portail à un seul bouton, implanté avec un réseau par transition. Exemple du module Formations."},"gate-grafcet-ladder":{"label":"Portail à télécommande : trois blocs","description":"Portail à un seul bouton, implanté en trois blocs. Exemple du module Formations."}}},"now":"$undefined","timeZone":"UTC","children":"$L1c"}]
