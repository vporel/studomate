tPassword":{"intro":"Introduce tu dirección de correo. Recibirás un enlace para restablecer tu contraseña.","submit":"Enviar el enlace","backToSignIn":"Volver a iniciar sesión","emailSent":"Se envió un correo de restablecimiento. Revisa tu bandeja de entrada."},"errors":{"invalidCredentials":"Correo o contraseña incorrectos.","invalidPseudoCredentials":"Nombre de usuario o contraseña incorrectos.","emailAlreadyExists":"Ya existe una cuenta con esta dirección de correo.","pseudoTaken":"Este nombre de usuario ya está en uso. Elige otro.","emailNotConfirmed":"Tu dirección de correo aún no está confirmada. Revisa tu bandeja de entrada.","rateLimit":"Demasiados intentos. Espera unos minutos antes de volver a intentarlo.","weakPassword":"Contraseña demasiado débil. Usa al menos 8 caracteres.","invalidEmail":"Dirección de correo no válida.","network":"No se puede contactar con el servidor. Comprueba tu conexión.","signInFailed":"Falló el inicio de sesión. Comprueba tus credenciales.","signUpFailed":"Falló la creación de la cuenta. Inténtalo de nuevo.","wrongPassword":"Contraseña incorrecta.","repatriationFailed":"No se pudieron mover tus proyectos de la nube a este navegador. Tu cuenta no se ha eliminado.","deleteAccountFailed":"Falló la eliminación de la cuenta. Inténtalo de nuevo."},"cloudAccount":{"title":"Cuenta en la nube","projectCount":"{count, plural, one {# proyecto en la nube} other {# proyectos en la nube}}","projectCountLoading":"Cargando proyectos…","openProject":"Abrir un proyecto","signOut":"Cerrar sesión","deleteAccount":"Eliminar mi cuenta"},"deleteAccount":{"title":"Eliminar mi cuenta","warning":"Esta acción no se puede deshacer: se eliminarán tu cuenta, tu perfil y tu progreso en la formación. Los enlaces para compartir tus proyectos dejarán de funcionar.","repatriation":"{count, plural, one {Tu proyecto en la nube se moverá} other {Tus # proyectos en la nube se moverán}} a este navegador antes de la eliminación.","noCloudProjects":"Tus proyectos locales no se ven afectados.","passwordLabel":"Confirma con tu contraseña","confirm":"Eliminar definitivamente","cancel":"Cancelar","deleted":"Tu cuenta ha sido eliminada."}},"profile":{"prompt":{"userTypeTitle":"Usas Studomate como…","userTypeHint":"Opcional, para ayudarnos a entender quién usa la aplicación.","schoolTypeTitle":"Una última pregunta","schoolTypeQuestion":"¿En qué tipo de centro estudias?","skip":"Omitir"},"fields":{"userType":"Usas Studomate como","schoolType":"Tipo de centro","notProvided":"No indicado"},"userTypes":{"student":"Estudiante","teacher":"Docente / formador","professional":"Profesional de la automatización","self_learner":"Autodidacta / curioso","other":"Otro"},"schoolTypes":{"high_school":"Instituto (secundaria)","bts":"BTS (formación profesional superior, Francia)","iut":"IUT / BUT (instituto universitario de tecnología, Francia)","university":"Universidad","engineering_school":"Escuela de ingeniería","other":"Otro"}},"whatsNew":{"title":"Novedades de Studomate {version}","previous":"Anterior","next":"Siguiente","done":"Entendido","slides":{"spanishLanguage":{"title":"Studomate ahora habla español","body":"La interfaz de la aplicación, el manual de usuario, la formación y las páginas del sitio ya están disponibles en español. Elige el idioma en Archivo → Preferencias o con el selector de idioma de las páginas del sitio. Un proyecto creado en español usa las palabras clave de expresión de la IEC 61131-3 (AND, OR, NOT)."},"imageExport":{"title":"Exporte sus programas como imagen","body":"Los grafcets y los ladders ahora se pueden exportar a PNG o SVG, además de a PDF. El botón \"Exportar\" de la barra de herramientas ofrece el formato que prefiera, y la pestaña \"Exportar imagen\" de la ventana de exportación permite exportar varios programas a la vez. Un ladder grande se divide en imágenes A4 horizontales, agrupadas con las demás en un archivo ZIP."}}}},"now":"$undefined","timeZone":"UTC","children":["$L25","$L26"]}]
