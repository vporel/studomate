d":{"intro":"Entrez votre adresse email. Vous recevrez un lien pour réinitialiser votre mot de passe.","submit":"Envoyer le lien","backToSignIn":"Retour à la connexion","emailSent":"Un email de réinitialisation a été envoyé. Vérifiez votre boîte mail."},"errors":{"invalidCredentials":"Email ou mot de passe incorrect.","invalidPseudoCredentials":"Pseudo ou mot de passe incorrect.","emailAlreadyExists":"Un compte existe déjà avec cette adresse email.","pseudoTaken":"Ce pseudo est déjà utilisé. Choisissez-en un autre.","emailNotConfirmed":"Votre adresse email n'a pas encore été confirmée. Vérifiez votre boîte mail.","rateLimit":"Trop de tentatives. Veuillez patienter quelques minutes avant de réessayer.","weakPassword":"Mot de passe trop faible. Utilisez au moins 8 caractères.","invalidEmail":"Adresse email invalide.","network":"Impossible de contacter le serveur. Vérifiez votre connexion.","signInFailed":"Connexion impossible. Vérifiez vos identifiants.","signUpFailed":"Création de compte impossible. Veuillez réessayer.","wrongPassword":"Mot de passe incorrect.","repatriationFailed":"Impossible de rapatrier vos projets cloud en local. Votre compte n'a pas été supprimé.","deleteAccountFailed":"La suppression du compte a échoué. Veuillez réessayer."},"cloudAccount":{"title":"Compte Cloud","projectCount":"{count, plural, one {# projet dans le cloud} other {# projets dans le cloud}}","projectCountLoading":"Chargement des projets…","openProject":"Ouvrir un projet","signOut":"Se déconnecter","deleteAccount":"Supprimer mon compte"},"deleteAccount":{"title":"Supprimer mon compte","warning":"Cette action est définitive : votre compte, votre profil et votre progression de formation seront supprimés. Les liens de partage de vos projets cesseront de fonctionner.","repatriation":"{count, plural, one {Votre projet cloud sera rapatrié} other {Vos # projets cloud seront rapatriés}} en local dans ce navigateur avant la suppression.","noCloudProjects":"Vos projets locaux ne sont pas co