20:["$","$L1b",null,{"component":"section","children":[["$","$L19",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":5,"children":"Un cours prêt à l'emploi"}],["$","$L19",null,{"mb":2,"children":"La formation suit une progression en six modules, de la logique de base à l'implantation d'un GRAFCET en Ladder. Chaque module alterne théorie et exercices corrigés à simuler, et le glossaire définit chaque terme."}],["$","$L1b",null,{"component":"ul","sx":{"pl":3,"my":0},"children":[["$","$L19","0",{"component":"li","mb":1,"children":["$","$L23","a0",{"href":"/training/a0","children":"Les bases de l'automatisme"}]}],["$","$L19","1",{"component":"li","mb":1,"children":["$","$L23","a1",{"href":"/training/a1","children":"Les bases du GRAFCET"}]}],["$","$L19","2",{"component":"li","mb":1,"children":["$","$L23","a2",{"href":"/training/a2","children":"Ladder : logique et mémoire"}]}],["$","$L19","3",{"component":"li","mb":1,"children":["$","$L23","a3",{"href":"/training/a3","children":"Ladder : temps, comptage et calcul"}]}],["$","$L19","4",{"component":"li","mb":1,"children":["$","$L23","a4",{"href":"/training/a4","children":"Du GRAFCET au Ladder (partie 1)"}]}],["$","$L19","5",{"component":"li","mb":1,"children":["$","$L23","a5",{"href":"/training/a5","children":"Du GRAFCET au Ladder (partie 2)"}]}],["$","$L19","6",{"component":"li","mb":1,"children":["$","$L23","glossary",{"href":"/training/glossary","children":"Glossaire de l'automatisme"}]}]]}]]}]
