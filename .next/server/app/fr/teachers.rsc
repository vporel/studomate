15:["$","$L28",null,{"formats":"$undefined","locale":"fr","messages":{"public":{"header":{"home":"Accueil","manual":"Manuel","about":"À propos","training":"Formations","openApp":"Ouvrir l'application","menu":"Menu","back":"Retour"},"footer":{"resources":"Ressources","manual":"Manuel utilisateur","about":"À propos","training":"Formations","glossary":"Glossaire","teachers":"Enseignants","legalTitle":"Légal","legalMentions":"Mentions légales","terms":"Conditions d'utilisation","privacy":"Politique de confidentialité","license":"Licence AGPL v3","contact":"Contact","reportIssue":"Signaler un problème","copyright":"© {year} Studomate","createdBy":"Créé par","slogan":"Créer, Simuler, Automatiser"}},"common":{"languageSwitch":{"label":"Langue","fr":"Français","en":"English"},"modal":{"close":"Fermer"}},"auth":{"accountStatus":{"tooltip":"Connectez-vous pour associer vos projets à votre compte","signIn":"Se connecter","signOut":"Se déconnecter"},"titles":{"signIn":"Se connecter","signUp":"Créer un compte","resetPassword":"Mot de passe oublié"},"modeSelector":{"pseudo":"Pseudo","email":"Email","anonymous":"Anonyme","withEmail":"Avec email"},"fields":{"pseudo":"Pseudo","email":"Email","password":"Mot de passe","pseudoHelper":"Votre identifiant public. Doit être unique."},"signIn":{"submit":"Se connecter","forgotPassword":"Mot de passe oublié ?","noAccount":"Pas de compte ? En créer un"},"forgottenPseudoPassword":{"title":"Mot de passe oublié","body":"Un compte créé avec un pseudo n'a pas d'adresse email : nous ne pouvons pas vous envoyer de lien de réinitialisation. Contactez-nous en indiquant votre pseudo, nous vous aiderons à récupérer l'accès à votre compte.","contact":"Nous contacter","close":"Fermer"},"signUp":{"submit":"Créer le compte","haveAccount":"Déjà un compte ? Se connecter","anonymousNotice":"Aucune donnée personnelle n'est collectée en mode anonyme. En contrepartie, la récupération du mot de passe est impossible si vous l'oubliez."},"resetPassword":{"intro":"Entrez votre adresse email. Vous recevrez un lien pour réinitialiser votre mot de passe.","submit":"Envoyer le lien","backToSignIn":"Retour à la connexion","emailSent":"Un email de réinitialisation a été envoyé. Vérifiez votre boîte mail."},"errors":{"invalidCredentials":"Email ou mot de passe incorrect.","invalidPseudoCredentials":"Pseudo ou mot de passe incorrect.","emailAlreadyExists":"Un compte existe déjà avec cette adresse email.","pseudoTaken":"Ce pseudo est déjà utilisé. Choisissez-en un autre.","emailNotConfirmed":"Votre adresse email n'a pas encore été confirmée. Vérifiez votre boîte mail.","rateLimit":"Trop de tentatives. Veuillez patienter quelques minutes avant de réessayer.","weakPassword":"Mot de passe trop faible. Utilisez au moins 8 caractères.","invalidEmail":"Adresse email invalide.","network":"Impossible de contacter le serveur. Vérifiez votre connexion.","signInFailed":"Connexion impossible. Vérifiez vos identifiants.","signUpFailed":"Création de compte impossible. Veuillez réessayer.","wrongPassword":"Mot de passe incorrect.","repatriationFailed":"Impossible de rapatrier vos projets cloud en local. Votre compte n'a pas été supprimé.","deleteAccountFailed":"La suppression du compte a échoué. Veuillez réessayer."},"cloudAccount":{"title":"Compte Cloud","projectCount":"{count, plural, one {# projet dans le cloud} other {# projets dans le cloud}}","projectCountLoading":"Chargement des projets…","openProject":"Ouvrir un projet","signOut":"Se déconnecter","deleteAccount":"Supprimer mon compte"},"deleteAccount":{"title":"Supprimer mon compte","warning":"Cette action est définitive : votre compte, votre profil et votre progression de formation seront supprimés. Les liens de partage de vos projets cesseront de fonctionner.","repatriation":"{count, plural, one {Votre projet cloud sera rapatrié} other {Vos # projets cloud seront rapatriés}} en local dans ce navigateur avant la suppression.","noCloudProjects":"Vos projets locaux ne sont pas concernés.","passwordLabel":"Confirmez avec votre mot de passe","confirm":"Supprimer définitivement","cancel":"Annuler","deleted":"Votre compte a été supprimé."}},"profile":{"prompt":{"userTypeTitle":"Vous utilisez Studomate en tant que…","userTypeHint":"Facultatif, pour mieux connaître les utilisateurs de l'application.","schoolTypeTitle":"Une dernière question","schoolTypeQuestion":"Dans quel type d'établissement étudiez-vous ?","skip":"Passer"},"fields":{"userType":"Vous utilisez Studomate en tant que","schoolType":"Type d'établissement","notProvided":"Non renseigné"},"userTypes":{"student":"Étudiant","teacher":"Enseignant / formateur","professional":"Professionnel de l'automatisme","self_learner":"Autodidacte / curieux","other":"Autre"},"schoolTypes":{"high_school":"Lycée","bts":"BTS","iut":"IUT / BUT","university":"Université","engineering_school":"École d'ingénieurs","other":"Autre"}},"whatsNew":{"title":"Nouveautés de Studomate {version}","previous":"Précédent","next":"Suivant","done":"Compris","slides":{"grafcetEditor":{"title":"L'éditeur GRAFCET devient plus intelligent","body":"Déposez ou déplacez une étape, une transition, une action ou un renvoi à côté d'un élément compatible : la liaison se crée toute seule et l'élément se recale. En déplaçant une étape ou une transition, ses actions et ses renvois alignés l'accompagnent."},"actionChains":{"title":"Chaînez les actions d'une étape","body":"Une action a maintenant un point de connexion à droite : reliez-la à l'action suivante pour former une chaîne étape → action → action. Une nouvelle action se chaîne toute seule derrière la précédente, et une action déplacée emmène la suite de sa chaîne. Si vous supprimez l'étape, la chaîne reste soudée : reliez sa première action à une autre étape pour tout rattacher."},"scene3dDisplay":{"title":"La scène 3D s'affiche où vous voulez","body":"Affichez la scène 3D dans un panneau à droite des éditeurs, pour suivre le grafcet et la partie opérative côte à côte, par exemple en projection. Vous pouvez aussi l'ouvrir dans un cadre flottant que vous déplacez et redimensionnez comme une fenêtre, dans une page de l'éditeur ou dans un onglet du navigateur. Le menu Affichage et le bouton « Scène 3D » de la barre d'état ouvrent la scène dans le mode choisi."}}}},"now":"$undefined","timeZone":"UTC","children":["$L29","$L2a"]}]
