d":{"intro":"Entrez votre adresse email. Vous recevrez un lien pour réinitialiser votre mot de passe.","submit":"Envoyer le lien","backToSignIn":"Retour à la connexion","emailSent":"Un email de réinitialisation a été envoyé. Vérifiez votre boîte mail."},"errors":{"invalidCredentials":"Email ou mot de passe incorrect.","invalidPseudoCredentials":"Pseudo ou mot de passe incorrect.","emailAlreadyExists":"Un compte existe déjà avec cette adresse email.","pseudoTaken":"Ce pseudo est déjà utilisé. Choisissez-en un autre.","emailNotConfirmed":"Votre adresse email n'a pas encore été confirmée. Vérifiez votre boîte mail.","rateLimit":"Trop de tentatives. Veuillez patienter quelques minutes avant de réessayer.","weakPassword":"Mot de passe trop faible. Utilisez au moins 8 caractères.","invalidEmail":"Adresse email invalide.","network":"Impossible de contacter le serveur. Vérifiez votre connexion.","signInFailed":"Connexion impossible. Vérifiez vos identifiants.","signUpFailed":"Création de compte impossible. Veuillez réessayer.","wrongPassword":"Mot de passe incorrect.","repatriationFailed":"Impossible de rapatrier vos projets cloud en local. Votre compte n'a pas été supprimé.","deleteAccountFailed":"La suppression du compte a échoué. Veuillez réessayer."},"cloudAccount":{"title":"Compte Cloud","projectCount":"{count, plural, one {# projet dans le cloud} other {# projets dans le cloud}}","projectCountLoading":"Chargement des projets…","openProject":"Ouvrir un projet","signOut":"Se déconnecter","deleteAccount":"Supprimer mon compte"},"deleteAccount":{"title":"Supprimer mon compte","warning":"Cette action est définitive : votre compte, votre profil et votre progression de formation seront supprimés. Les liens de partage de vos projets cesseront de fonctionner.","repatriation":"{count, plural, one {Votre projet cloud sera rapatrié} other {Vos # projets cloud seront rapatriés}} en local dans ce navigateur avant la suppression.","noCloudProjects":"Vos projets locaux ne sont pas concernés.","passwordLabel":"Confirmez avec votre mot de passe","confirm":"Supprimer définitivement","cancel":"Annuler","deleted":"Votre compte a été supprimé."}},"profile":{"prompt":{"userTypeTitle":"Vous utilisez Studomate en tant que…","userTypeHint":"Facultatif, pour mieux connaître les utilisateurs de l'application.","schoolTypeTitle":"Une dernière question","schoolTypeQuestion":"Dans quel type d'établissement étudiez-vous ?","skip":"Passer"},"fields":{"userType":"Vous utilisez Studomate en tant que","schoolType":"Type d'établissement","notProvided":"Non renseigné"},"userTypes":{"student":"Étudiant","teacher":"Enseignant / formateur","professional":"Professionnel de l'automatisme","self_learner":"Autodidacte / curieux","other":"Autre"},"schoolTypes":{"high_school":"Lycée","bts":"BTS","iut":"IUT / BUT","university":"Université","engineering_school":"École d'ingénieurs","other":"Autre"}},"whatsNew":{"title":"Nouveautés de Studomate {version}","previous":"Précédent","next":"Suivant","done":"Compris","slides":{"spanishLanguage":{"title":"Studomate parle espagnol","body":"L'interface de l'application, le manuel, la formation et les pages du site sont désormais disponibles en espagnol. Choisissez la langue dans Fichier → Préférences ou avec le sélecteur de langue des pages du site. Un projet créé en espagnol utilise les mots-clés d'expression de la CEI 61131-3 (AND, OR, NOT)."},"imageExport":{"title":"Exportez vos programmes en image","body":"Les grafcets et les ladders s'exportent désormais en PNG ou en SVG, en plus du PDF. Le bouton « Exporter » de la barre d'outils propose le format de votre choix, et l'onglet « Export image » de la fenêtre d'export permet d'exporter plusieurs programmes d'un coup. Un ladder trop grand est découpé en images au format A4 paysage, regroupées avec les autres dans une archive ZIP."}}}},"now":"$undefined","timeZone":"UTC","children":["$L1e","$L1f"]}]
