18:T5df7,{"@context":"https://schema.org","@type":"DefinedTermSet","name":"Glossaire de l'automatisme","description":"Glossaire de l'automatisme : étape, transition, contact, bobine, TON, compteur, front... chaque terme du GRAFCET et du Ladder défini simplement, avec schémas.","inLanguage":"fr","url":"https://studomate.com/formations/glossaire","hasDefinedTerm":[{"@type":"DefinedTerm","name":"Action","description":"Rectangle accroché à une étape : ce que le système fait tant que l'étape est active, comme allumer une sortie.","url":"https://studomate.com/formations/glossaire#action","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Action mémorisée","alternateName":["Set","Reset","action Set"],"description":"Action dont la variable reste vraie quand l'étape se désactive, jusqu'à ce qu'une autre action la remette à faux (Reset).","url":"https://studomate.com/formations/glossaire#set-action","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Amont, aval","description":"Avant et après, dans le sens de lecture du GRAFCET (de haut en bas). L'étape amont précède une transition, l'étape aval la suit.","url":"https://studomate.com/formations/glossaire#upstream-downstream","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Arrêt prioritaire","alternateName":["marche prioritaire"],"description":"Auto-maintien où l'arrêt l'emporte si marche et arrêt sont actionnés ensemble. La priorité dépend de l'ordre des contacts.","url":"https://studomate.com/formations/glossaire#priority-stop","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Auto-maintien","alternateName":["mémorisation par contact de la bobine","maintien"],"description":"Montage où un contact de la bobine elle-même est placé en parallèle du bouton de marche : la sortie reste active après le relâchement du bouton.","url":"https://studomate.com/formations/glossaire#self-holding","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Automate","alternateName":["API","automate programmable industriel"],"description":"Petit ordinateur industriel qui lit des entrées (boutons, capteurs), exécute un programme, puis commande des sorties (voyants, contacteurs, vannes).","url":"https://studomate.com/formations/glossaire#plc","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Bases de temps système","alternateName":["_SYS_TB","horloge système"],"description":"Variables en lecture seule fournies par Studomate (préfixe _SYS_) qui alternent entre vrai et faux à cadence fixe, de 200 ms à 2 s, par exemple pour faire clignoter un voyant.","url":"https://studomate.com/formations/glossaire#system-time-bases","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Bloc fonctionnel","alternateName":["bloc"],"description":"Rectangle Ladder qui réalise une fonction toute faite (temporisation, comptage, calcul) à partir de broches d'entrée à gauche et de sortie à droite.","url":"https://studomate.com/formations/glossaire#function-block","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Bobine","alternateName":["bobine de sortie"],"description":"Symbole en bout de réseau qui écrit une variable : elle prend la valeur du chemin de contacts qui la précède.","url":"https://studomate.com/formations/glossaire#coil","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Bobines S et R","alternateName":["Set","Reset","bistable","mise à 1","mise à 0"],"description":"Une bobine S (Set) met sa variable à 1 et la laisse ; une bobine R (Reset) la remet à 0. Entre deux ordres, la variable garde sa valeur.","url":"https://studomate.com/formations/glossaire#set-reset","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Bouton poussoir","description":"Organe de commande qui change d'état tant qu'on appuie dessus et revient seul au repos quand on le relâche.","url":"https://studomate.com/formations/glossaire#push-button","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Branche","description":"Une des séquences qui partent d'une divergence.","url":"https://studomate.com/formations/glossaire#branch","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Câblage à fermeture (NO) et à ouverture (NF)","alternateName":["NO","NF","normalement ouvert","normalement fermé"],"description":"Façon de brancher un bouton ou un capteur. Câblé à fermeture (NO), il vaut 0 au repos et 1 quand on agit dessus ; câblé à ouverture (NF), il vaut 1 au repos et 0 quand on agit dessus.","url":"https://studomate.com/formations/glossaire#wiring","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Chronogramme","alternateName":["diagramme temporel"],"description":"Graphique qui montre l'évolution de plusieurs signaux au cours du temps, les uns sous les autres sur le même axe.","url":"https://studomate.com/formations/glossaire#chronogram","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Commutateur","alternateName":["interrupteur","commutateur maintenu"],"description":"Organe de commande qui garde sa position après action : il reste enclenché jusqu'à ce qu'on le rebascule.","url":"https://studomate.com/formations/glossaire#switch","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Compteur","alternateName":["CTU","CTD","CTUD","comptage","décomptage"],"description":"Bloc qui compte des fronts montants. CTU incrémente sur CU, CTD décrémente sur CD (avec LD pour charger la valeur PV), CTUD fait les deux. La valeur courante est sur la broche CV.","url":"https://studomate.com/formations/glossaire#counter","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Contact","alternateName":["contact NO","contact NF"],"description":"Symbole qui lit une variable. Un contact NO (normalement ouvert) est passant quand sa variable est vraie ; un contact NF (normalement fermé) est passant quand elle est fausse.","url":"https://studomate.com/formations/glossaire#contact","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Contacteur","description":"Interrupteur de puissance commandé par une bobine : il permet à une sortie de faible puissance de commander un moteur ou une charge importante.","url":"https://studomate.com/formations/glossaire#contactor","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Contacts de front P et N","alternateName":["contact P","contact N","front montant","front descendant"],"description":"Un contact P est passant pendant un seul cycle, au front montant de sa variable ; un contact N l'est au front descendant.","url":"https://studomate.com/formations/glossaire#edge-contacts","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Contacts en série et en parallèle","alternateName":["en série","en parallèle"],"description":"Des contacts en série (l'un derrière l'autre) forment un ET ; des contacts en parallèle (sur deux chemins) forment un OU.","url":"https://studomate.com/formations/glossaire#series-parallel","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Convergence","description":"Point où des branches se rejoignent. En ET, la suite ne repart que lorsque toutes les branches sont arrivées ; en OU, dès qu'une branche arrive.","url":"https://studomate.com/formations/glossaire#convergence","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Conversion","alternateName":["élargissement","rétrécissement","*_TO_*"],"description":"Changement du type d'une valeur. Un élargissement (INT vers DINT) est sans risque ; un rétrécissement (REAL vers INT) peut perdre de l'information et se demande explicitement.","url":"https://studomate.com/formations/glossaire#conversion","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Cycle de scrutation","alternateName":["cycle automate","scan"],"description":"Tour que l'automate répète sans cesse, en trois temps : lire les entrées, exécuter le programme, écrire les sorties.","url":"https://studomate.com/formations/glossaire#scan-cycle","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Dépassement","alternateName":["débordement"],"description":"Résultat qui sort de la plage de son type : un INT qui passe 32767 repart de la borne basse.","url":"https://studomate.com/formations/glossaire#overflow","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Divergence en ET","alternateName":["séquences simultanées","parallélisme"],"description":"Point où la séquence se sépare en plusieurs branches qui démarrent toutes en même temps et évoluent ensuite indépendamment.","url":"https://studomate.com/formations/glossaire#and-divergence","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Divergence en OU","alternateName":["choix de séquence","sélection de séquence"],"description":"Point où la séquence se sépare en plusieurs chemins dont un seul est pris, selon la réceptivité qui devient vraie en premier.","url":"https://studomate.com/formations/glossaire#or-divergence","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Divergence et convergence","alternateName":["jonction","barre"],"description":"Une divergence sépare une séquence en plusieurs branches, une convergence les rassemble. Une barre simple signifie OU, une barre double signifie ET.","url":"https://studomate.com/formations/glossaire#divergences","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Double bobine","description":"Erreur courante : écrire la même variable avec deux bobines. Seul le dernier réseau exécuté compte, ce qui masque le premier.","url":"https://studomate.com/formations/glossaire#double-coil","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Entrée","description":"Variable lue par le programme et alimentée par le monde extérieur : bouton, commutateur, capteur.","url":"https://studomate.com/formations/glossaire#input","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"ET","alternateName":["AND","en série"],"description":"Opérateur vrai seulement si toutes ses conditions sont vraies.","url":"https://studomate.com/formations/glossaire#and","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Étape","description":"Carré numéroté qui représente un état stable du système. Elle est active ou inactive ; une étape active est repérée par un fond coloré dans l'éditeur.","url":"https://studomate.com/formations/glossaire#step","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Étape initiale","description":"Étape à double contour, active à la mise sous tension ou après une remise à zéro. Un GRAFCET en possède au moins une.","url":"https://studomate.com/formations/glossaire#initial-step","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Évolution","alternateName":["franchir","franchissement d'une transition"],"description":"Franchissement d'une transition : quand l'étape amont est active et la réceptivité vraie, l'étape amont se désactive et l'étape aval s'active.","url":"https://studomate.com/formations/glossaire#evolution","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Exclusivité","description":"Propriété des branches d'une divergence en OU dont les réceptivités ne peuvent pas être vraies en même temps.","url":"https://studomate.com/formations/glossaire#exclusivity","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Fin de course","description":"Capteur actionné mécaniquement quand une pièce mobile (portail, vérin) arrive au bout de sa course.","url":"https://studomate.com/formations/glossaire#limit-switch","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Front","description":"Instant précis où un signal change de valeur : front montant (de faux à vrai) ou front descendant (de vrai à faux).","url":"https://studomate.com/formations/glossaire#edge","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Front descendant","description":"Passage d'un signal de vrai à faux, détecté pendant un seul cycle.","url":"https://studomate.com/formations/glossaire#falling-edge","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Front montant","description":"Passage d'un signal de faux à vrai, détecté pendant un seul cycle.","url":"https://studomate.com/formations/glossaire#rising-edge","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Hystérésis","description":"Écart entre le seuil d'enclenchement et le seuil de déclenchement, pour éviter qu'une sortie ne clignote quand la mesure oscille autour d'une valeur.","url":"https://studomate.com/formations/glossaire#hysteresis","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Instance","description":"Exemplaire d'un bloc fonctionnel, avec son propre état : deux temporisations TON sont deux instances indépendantes.","url":"https://studomate.com/formations/glossaire#instance","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Ladder","alternateName":["LD","langage à contacts","schéma à relais"],"description":"Langage graphique de programmation des automates : des contacts à gauche (les conditions) commandent une bobine à droite (l'action).","url":"https://studomate.com/formations/glossaire#ladder","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Liaison orientée","description":"Trait qui relie étapes et transitions, lu de haut en bas. Une flèche n'est dessinée que lorsqu'il remonte.","url":"https://studomate.com/formations/glossaire#directed-link","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Main","alternateName":["programme principal"],"description":"Programme principal d'un projet, exécuté à chaque cycle. Il appelle les sous-programmes et ne peut pas être exclu de l'exécution.","url":"https://studomate.com/formations/glossaire#main","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Mémoire interne","alternateName":["mémoire","bit mémoire"],"description":"Variable qui n'est ni une entrée ni une sortie : le programme s'en sert pour retenir un état entre deux cycles.","url":"https://studomate.com/formations/glossaire#internal-memory","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Mémoire rémanente","alternateName":["rémanence"],"description":"Mémoire qui conserve sa valeur après une coupure de courant ou un redémarrage, contrairement à une mémoire ordinaire qui repart à 0.","url":"https://studomate.com/formations/glossaire#retentive","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Mise à l'échelle","alternateName":["scaling","valeur brute"],"description":"Calcul qui convertit une valeur brute d'un capteur analogique en une grandeur physique (température, niveau), généralement par une droite.","url":"https://studomate.com/formations/glossaire#scaling","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Mnémonique","alternateName":["nom de variable"],"description":"Nom court et parlant d'une variable (pompe, arret), que les programmes utilisent pour la désigner. Une adresse (%I0.1) peut s'y ajouter pour relier la variable à du matériel physique.","url":"https://studomate.com/formations/glossaire#mnemonic","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"NON","alternateName":["NOT","inversion"],"description":"Opérateur qui inverse une condition : vrai devient faux, faux devient vrai.","url":"https://studomate.com/formations/glossaire#not","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Ordre d'exécution","description":"Règle de lecture du programme : les réseaux s'exécutent de haut en bas, et les GRAFCET avant le Ladder.","url":"https://studomate.com/formations/glossaire#execution-order","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"OU","alternateName":["OR","en parallèle"],"description":"Opérateur vrai dès qu'une de ses conditions est vraie.","url":"https://studomate.com/formations/glossaire#or","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Rails","alternateName":["rail gauche","rail droit"],"description":"Les deux traits verticaux qui encadrent un réseau Ladder : le courant fictif part du rail gauche et arrive au rail droit.","url":"https://studomate.com/formations/glossaire#rails","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Réceptivité","alternateName":["condition de transition"],"description":"Condition de passage d'une transition : une expression vraie ou fausse, comme fin1 ou dcy ET NON arret.","url":"https://studomate.com/formations/glossaire#receptivity","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Réinitialiser","alternateName":["remise à zéro","reset du GRAFCET"],"description":"Remettre tout le GRAFCET dans son état de départ : toutes les étapes à l'état inactif, sauf l'étape initiale qui redevient active.","url":"https://studomate.com/formations/glossaire#reinitialize","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Réseau","alternateName":["rung","section"],"description":"Un bloc du programme Ladder, délimité par ses deux rails. Il contient des lignes de contacts menant à des bobines. Dans le cas le plus simple, une seule ligne : des contacts à gauche, une bobine à droite. Il se lit de gauche à droite.","url":"https://studomate.com/formations/glossaire#network","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Sortie","description":"Variable écrite par le programme pour commander un voyant, un contacteur, une vanne ou un moteur.","url":"https://studomate.com/formations/glossaire#output","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Sous-programme","alternateName":["appel de sous-programme"],"description":"Programme appelé depuis un autre par un bloc d'appel. Il permet de découper un projet en parties lisibles et réutilisables.","url":"https://studomate.com/formations/glossaire#subprogram","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Table de vérité","description":"Tableau qui donne la valeur d'une expression logique pour chaque combinaison de ses variables (0 = faux, 1 = vrai).","url":"https://studomate.com/formations/glossaire#truth-table","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Télérupteur","alternateName":["bascule","va-et-vient mémorisé"],"description":"Montage où chaque appui sur un bouton inverse l'état d'une sortie : un appui allume, l'appui suivant éteint.","url":"https://studomate.com/formations/glossaire#toggle","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Temporisation","alternateName":["temporisateur","timer"],"description":"Bloc qui mesure une durée. Il reçoit une entrée IN et une durée PT (le temps programmé), et sa sortie Q répond selon le type : TON, TOF ou TP.","url":"https://studomate.com/formations/glossaire#timer","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"TOF","alternateName":["retard au déclenchement","temporisation au repos"],"description":"Temporisation au déclenchement : Q passe à vrai dès que IN est vraie et reste vraie pendant la durée PT après que IN est retombée.","url":"https://studomate.com/formations/glossaire#tof","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"TON","alternateName":["retard à l'enclenchement","temporisation au travail"],"description":"Temporisation à l'enclenchement : la sortie Q passe à vrai quand IN est restée vraie pendant toute la durée PT, et retombe dès que IN retombe.","url":"https://studomate.com/formations/glossaire#ton","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"TP","alternateName":["impulsion"],"description":"Temporisation en impulsion : un front montant sur IN déclenche une sortie Q vraie pendant exactement la durée PT, quoi que fasse IN ensuite.","url":"https://studomate.com/formations/glossaire#tp","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Transition","description":"Petit trait horizontal qui relie deux étapes et porte une réceptivité : la condition à remplir pour passer de l'une à l'autre.","url":"https://studomate.com/formations/glossaire#transition","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Type","alternateName":["BOOL","INT","DINT","REAL","type de variable"],"description":"Nature de la valeur d'une variable : BOOL (vrai ou faux), INT et DINT (entiers de 16 et 32 bits), REAL (nombre à virgule).","url":"https://studomate.com/formations/glossaire#data-type","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Valeur de présélection","alternateName":["PV","présélection"],"description":"Valeur cible d'un compteur (broche PV). La sortie Q d'un CTU passe à vrai quand le compte CV atteint PV.","url":"https://studomate.com/formations/glossaire#preset-value","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Variable","description":"Donnée nommée manipulée par le programme : une entrée, une sortie ou une mémoire interne. Une variable logique vaut VRAI ou FAUX (1 ou 0).","url":"https://studomate.com/formations/glossaire#variable","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Variable d'étape (Xn)","alternateName":["Xn","X2"],"description":"Variable logique associée à l'étape n : elle vaut VRAI quand l'étape est active (X2 = VRAI).","url":"https://studomate.com/formations/glossaire#step-variable","inDefinedTermSet":"https://studomate.com/formations/glossaire"},{"@type":"DefinedTerm","name":"Verrouillage","alternateName":["verrouillage mutuel"],"description":"Condition qui interdit à deux sorties d'être actives en même temps, comme les deux sens d'un moteur : chacune ne peut s'enclencher que si l'autre est éteinte.","url":"https://studomate.com/formations/glossaire#interlock","inDefinedTermSet":"https://studomate.com/formations/glossaire"}]}7:["$","$L17",null,{"maxWidth":"md","sx":{"my":4},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$18"}}],"$L19","$L1a","$L1b"]}]
