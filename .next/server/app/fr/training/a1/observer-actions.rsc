15:["$","$L24",null,{"formats":"$undefined","locale":"fr","messages":{"public":{"header":{"home":"Accueil","manual":"Manuel","about":"À propos","training":"Formations","openApp":"Ouvrir l'application","menu":"Menu","back":"Retour"},"footer":{"resources":"Ressources","manual":"Manuel utilisateur","about":"À propos","training":"Formations","legalTitle":"Légal","legalMentions":"Mentions légales","terms":"Conditions d'utilisation","privacy":"Politique de confidentialité","license":"Licence AGPL v3","contact":"Contact","reportIssue":"Signaler un problème","copyright":"© {year} Studomate","createdBy":"Créé par","slogan":"Créer, Simuler, Automatiser"}},"common":{"languageSwitch":{"label":"Langue","fr":"Français","en":"English"}},"auth":{"accountStatus":{"tooltip":"Connectez-vous pour associer vos projets à votre compte","signIn":"Se connecter","signOut":"Se déconnecter"},"titles":{"signIn":"Se connecter","signUp":"Créer un compte","resetPassword":"Mot de passe oublié"},"modeSelector":{"pseudo":"Pseudo","email":"Email","anonymous":"Anonyme","withEmail":"Avec email"},"fields":{"pseudo":"Pseudo","email":"Email","password":"Mot de passe","pseudoHelper":"Votre identifiant public. Doit être unique."},"signIn":{"submit":"Se connecter","forgotPassword":"Mot de passe oublié ?","noAccount":"Pas de compte ? En créer un"},"signUp":{"submit":"Créer le compte","haveAccount":"Déjà un compte ? Se connecter","anonymousNotice":"Aucune donnée personnelle n'est collectée en mode anonyme. En contrepartie, la récupération du mot de passe est impossible si vous l'oubliez."},"resetPassword":{"intro":"Entrez votre adresse email. Vous recevrez un lien pour réinitialiser votre mot de passe.","submit":"Envoyer le lien","backToSignIn":"Retour à la connexion","emailSent":"Un email de réinitialisation a été envoyé. Vérifiez votre boîte mail."},"errors":{"invalidCredentials":"Email ou mot de passe incorrect.","invalidPseudoCredentials":"Pseudo ou mot de passe incorrect.","emailAlreadyExists":"Un compte e