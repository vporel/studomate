1d:["$","$L1b","Nothing for students to install",{"component":"section","children":[["$","$L19",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":5,"children":"Nothing for students to install"}],["$","$L1b",null,{"component":"ul","sx":{"pl":3,"my":0},"children":[["$","$L19","0",{"component":"li","mb":1,"children":"Studomate runs in the browser: nothing to install on the lab computers or at students' homes."}],["$","$L19","1",{"component":"li","mb":1,"children":"Without an account, projects stay in the student's browser. An account, with or without an email address, saves them to the cloud."}],["$","$L19","2",{"component":"li","mb":1,"children":"No tracking cookies, and free software under the AGPL v3 licence."}]]}]]}]
1e:["$","$L1b","Collecting and marking the work",{"component":"section","children":[["$","$L19",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":5,"children":"Collecting and marking the work"}],["$","$L1b",null,{"component":"ul","sx":{"pl":3,"my":0},"children":[["$","$L19","0",{"component":"li","mb":1,"children":"Each student sends you back a project file, or a share link to their copy."}],["$","$L19","1",{"component":"li","mb":1,"children":"The analyser reports the project's errors (invalid expression, unknown variable...) before simulation."}],["$","$L19","2",{"component":"li","mb":1,"children":"The project PDF export gives a cover page with the exercise statement, then the grafcets, the ladders and the variable tables: a basis for the lab report."}]]}]]}]
1f:["$","$L1b","Going further",{"component":"section","children":[["$","$L19",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":5,"children":"Going further"}],["$","$L1b",null,{"component":"ul","sx":{"pl":3,"my":0},"children":[["$","$L19","0",{"component":"li","mb":1,"children":"Connect the program to a 3D carton-sorting scene, driven by its outputs."}],["$","$L19","1",{"component":"li","mb":1,"children":"Load the program onto a real Arduino Uno R3 board, or use its inputs and outputs during simulation (Chrome or Edge)."}]]}]]}]
20:["$","$L1b",null,{"component":"section","children":[["$","$L19",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":5,"children":"A ready-to-use course"}],["$","$L19",null,{"mb":2,"children":"The training follows a six-module progression, from basic logic to implementing a GRAFCET in ladder logic. Each module alternates theory and solved exercises to simulate, and the glossary defines every term."}],["$","$L1b",null,{"component":"ul","sx":{"pl":3,"my":0},"children":[["$","$L19","0",{"component":"li","mb":1,"children":["$","$L23","a0",{"href":"/training/a0","children":"Automation basics"}]}],["$","$L19","1",{"component":"li","mb":1,"children":["$","$L23","a1",{"href":"/training/a1","children":"GRAFCET basics"}]}],["$","$L19","2",{"component":"li","mb":1,"children":["$","$L23","a2",{"href":"/training/a2","children":"Ladder logic and memory"}]}],["$","$L19","3",{"component":"li","mb":1,"children":["$","$L23","a3",{"href":"/training/a3","children":"Ladder timers, counters and calculation"}]}],["$","$L19","4",{"component":"li","mb":1,"children":["$","$L23","a4",{"href":"/training/a4","children":"From GRAFCET to ladder logic (part 1)"}]}],["$","$L19","5",{"component":"li","mb":1,"children":["$","$L23","a5",{"href":"/training/a5","children":"From GRAFCET to ladder logic (part 2)"}]}],["$","$L19","6",{"component":"li","mb":1,"children":["$","$L23","glossary",{"href":"/training/glossary","children":"Automation glossary"}]}]]}]]}]
21:["$","$L1b",null,{"component":"section","children":[["$","$L19",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":5,"children":"Frequently asked questions"}],[["$","$L1b","Does Studomate replace TIA Portal, Automgen or CODESYS?",{"mt":3,"children":[["$","$L19",null,{"variant":"h6","component":"h3","fontWeight":700,"children":"Does Studomate replace TIA Portal, Automgen or CODESYS?"}],["$","$L19",null,{"mt":0.5,"children":"No, and that is not its purpose. Studomate is for learning and practice: it simulates GRAFCET, ladder logic and HMI pages in the browser. It does not program an industrial PLC (Siemens, Schneider…), though it can drive an Arduino board. In class it complements the software of the workshop's PLC: students design and test their logic in Studomate, in the lab or at home, then carry it over to the real hardware. The notations follow the standards: IEC 60848 for GRAFCET, IEC 61131-3 blocks (TON, TOF, CTU…) for ladder logic."}]]}],["$","$L1b","Can students practise at home without PLC software?",{"mt":3,"children":[["$","$L19",null,{"variant":"h6","component":"h3","fontWeight":700,"children":"Can students practise at home without PLC software?"}],["$","$L19",null,{"mt":0.5,"children":"Yes. Studomate is free and runs in the browser with no installation, on Windows, macOS or Linux. A student can redo a lab exercise or follow the course on their own computer, with no licence and no hardware."}]]}],["$","$L1b","Does anything need to be installed on the lab computers?",{"mt":3,"children":[["$","$L19",null,{"variant":"h6","component":"h3","fontWeight":700,"children":"Does anything need to be installed on the lab computers?"}],["$","$L19",null,{"mt":0.5,"children":"No. A recent browser is enough. Only using an Arduino board requires Chrome or Edge."}]]}],["$","$L1b","Do students need to create an account?",{"mt":3,"children":[["$","$L19",null,{"variant":"h6","component":"h3","fontWeight":700,"children":"Do students need to create an account?"}],["$","$L19",null,{"mt":0.5,"children":"No. Without an account, they open the shared project and work in their browser. An account, with or without an email address, lets them find their projects on another device and share their own by link."}]]}],["$","$L1b","Is Studomate free to use in class?",{"mt":3,"children":[["$","$L19",null,{"variant":"h6","component":"h3","fontWeight":700,"children":"Is Studomate free to use in class?"}],["$","$L19",null,{"mt":0.5,"children":"Yes, in class as at home. The code is free software under the AGPL v3 licence."}]]}]]]}]
22:["$","$L24",null,{"sx":{"mt":5,"p":3,"textAlign":"center"},"children":[["$","$L19",null,{"variant":"h3","component":"h2","gutterBottom":true,"children":"Ready to prepare your first lab exercise?"}],["$","$L19",null,{"mb":2,"children":"Open the app and start from a ready-made project, or browse the training first."}],["$","$L1b",null,{"sx":{"display":"flex","flexWrap":"wrap","justifyContent":"center","gap":2},"children":[["$","$L25",null,{"component":"a","href":"/app","variant":"contained","startIcon":["$","$L26",null,{}],"children":"Open the app"}],["$","$L27",null,{"href":"/training","variant":"outlined","children":"See the training"}]]}]]}]
