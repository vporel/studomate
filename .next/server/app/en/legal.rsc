 been sent. Check your inbox."},"errors":{"invalidCredentials":"Wrong email or password.","invalidPseudoCredentials":"Wrong username or password.","emailAlreadyExists":"An account already exists with this email address.","pseudoTaken":"This username is already taken. Choose another one.","emailNotConfirmed":"Your email address has not been confirmed yet. Check your inbox.","rateLimit":"Too many attempts. Please wait a few minutes before trying again.","weakPassword":"Password too weak. Use at least 8 characters.","invalidEmail":"Invalid email address.","network":"Cannot reach the server. Check your connection.","signInFailed":"Sign-in failed. Check your credentials.","signUpFailed":"Account creation failed. Please try again.","wrongPassword":"Incorrect password.","repatriationFailed":"Could not move your cloud projects to this browser. Your account has not been deleted.","deleteAccountFailed":"Account deletion failed. Please try again."},"cloudAccount":{"title":"Cloud account","projectCount":"{count, plural, one {# project in the cloud} other {# projects in the cloud}}","projectCountLoading":"Loading projects…","openProject":"Open a project","signOut":"Sign out","deleteAccount":"Delete my account"},"deleteAccount":{"title":"Delete my account","warning":"This cannot be undone: your account, your profile and your training progress will be deleted. The share links of your projects will stop working.","repatriation":"{count, plural, one {Your cloud project will be moved} other {Your # cloud projects will be moved}} to this browser before the deletion.","noCloudProjects":"Your local projects are not affected.","passwordLabel":"Confirm with your password","confirm":"Delete permanently","cancel":"Cancel","deleted":"Your account has been deleted."}},"profile":{"prompt":{"userTypeTitle":"You use Studomate as a…","userTypeHint":"Optional, to help us understand who uses the app.","schoolTypeTitle":"One last question","schoolTypeQuestion":"What kind of school do you study in?",