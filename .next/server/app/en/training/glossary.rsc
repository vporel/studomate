18:T598a,{"@context":"https://schema.org","@type":"DefinedTermSet","name":"Automation glossary","description":"Automation glossary: step, transition, contact, coil, TON, counter, edge... every GRAFCET and Ladder term defined simply, with diagrams.","inLanguage":"en","url":"https://studomate.com/en/training/glossary","hasDefinedTerm":[{"@type":"DefinedTerm","name":"Action","description":"A rectangle attached to a step: what the system does while the step is active, such as turning an output on.","url":"https://studomate.com/en/training/glossary#action","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"AND","alternateName":["in series"],"description":"An operator that is true only if all its conditions are true.","url":"https://studomate.com/en/training/glossary#and","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"AND divergence","alternateName":["simultaneous sequences","parallelism"],"description":"A point where the sequence splits into several branches that all start at the same time and then evolve independently.","url":"https://studomate.com/en/training/glossary#and-divergence","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Branch","description":"One of the sequences starting from a divergence.","url":"https://studomate.com/en/training/glossary#branch","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Coil","alternateName":["output coil"],"description":"A symbol at the end of a network that writes a variable: it takes the value of the contact path before it.","url":"https://studomate.com/en/training/glossary#coil","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Contact","alternateName":["NO contact","NC contact"],"description":"A symbol that reads a variable. An NO contact (normally open) conducts when its variable is true; an NC contact (normally closed) conducts when it is false.","url":"https://studomate.com/en/training/glossary#contact","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Contactor","description":"A power switch driven by a coil: it lets a low-power output control a motor or a large load.","url":"https://studomate.com/en/training/glossary#contactor","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Contacts in series and in parallel","alternateName":["in series","in parallel"],"description":"Contacts in series (one after the other) form an AND; contacts in parallel (on two paths) form an OR.","url":"https://studomate.com/en/training/glossary#series-parallel","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Convergence","description":"A point where branches join back. In AND, the sequence continues only once all branches have arrived; in OR, as soon as one branch arrives.","url":"https://studomate.com/en/training/glossary#convergence","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Conversion","alternateName":["widening","narrowing","*_TO_*"],"description":"Changing the type of a value. A widening (INT to DINT) is safe; a narrowing (REAL to INT) can lose information and must be requested explicitly.","url":"https://studomate.com/en/training/glossary#conversion","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Counter","alternateName":["CTU","CTD","CTUD","counting up","counting down"],"description":"A block that counts rising edges. CTU increments on CU, CTD decrements on CD (with LD to load the PV value), CTUD does both. The current value is on the CV pin.","url":"https://studomate.com/en/training/glossary#counter","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Directed link","description":"A line joining steps and transitions, read from top to bottom. An arrow is drawn only when it goes back up.","url":"https://studomate.com/en/training/glossary#directed-link","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Divergence and convergence","alternateName":["junction","bar"],"description":"A divergence splits a sequence into several branches, a convergence joins them back. A single bar means OR, a double bar means AND.","url":"https://studomate.com/en/training/glossary#divergences","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Double coil","description":"A common mistake: writing the same variable with two coils. Only the last network executed counts, which hides the first.","url":"https://studomate.com/en/training/glossary#double-coil","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Edge","description":"The precise moment a signal changes value: rising edge (false to true) or falling edge (true to false).","url":"https://studomate.com/en/training/glossary#edge","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Edge contacts P and N","alternateName":["P contact","N contact","rising edge","falling edge"],"description":"A P contact conducts for a single cycle, on the rising edge of its variable; an N contact does so on the falling edge.","url":"https://studomate.com/en/training/glossary#edge-contacts","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Evolution","alternateName":["crossing","crossing a transition","firing"],"description":"Crossing a transition: when the upstream step is active and the receptivity is true, the upstream step deactivates and the downstream step activates.","url":"https://studomate.com/en/training/glossary#evolution","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Exclusivity","alternateName":["mutual exclusion"],"description":"A property of the branches of an OR divergence whose receptivities cannot be true at the same time.","url":"https://studomate.com/en/training/glossary#exclusivity","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Execution order","description":"The rule for reading the program: networks run from top to bottom, and GRAFCETs run before Ladder.","url":"https://studomate.com/en/training/glossary#execution-order","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Falling edge","description":"A signal going from true to false, detected during a single cycle.","url":"https://studomate.com/en/training/glossary#falling-edge","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Function block","alternateName":["block"],"description":"A Ladder rectangle that performs a ready-made function (timing, counting, calculation) from input pins on the left and output pins on the right.","url":"https://studomate.com/en/training/glossary#function-block","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Hysteresis","description":"A gap between the switch-on threshold and the switch-off threshold, to prevent an output from flickering when the measurement oscillates around one value.","url":"https://studomate.com/en/training/glossary#hysteresis","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Initial step","description":"A step with a double outline, active at power-up or after a reset. A GRAFCET has at least one.","url":"https://studomate.com/en/training/glossary#initial-step","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Input","description":"A variable read by the program and driven by the outside world: button, switch, sensor.","url":"https://studomate.com/en/training/glossary#input","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Instance","description":"One copy of a function block, with its own state: two TON timers are two independent instances.","url":"https://studomate.com/en/training/glossary#instance","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Interlock","alternateName":["mutual interlock"],"description":"A condition that forbids two outputs from being active at the same time, like the two directions of a motor: each can start only if the other is off.","url":"https://studomate.com/en/training/glossary#interlock","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Internal memory","alternateName":["memory","memory bit"],"description":"A variable that is neither an input nor an output: the program uses it to remember a state between two cycles.","url":"https://studomate.com/en/training/glossary#internal-memory","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Ladder","alternateName":["LD","ladder diagram","relay diagram"],"description":"A graphical PLC programming language: contacts on the left (the conditions) drive a coil on the right (the action).","url":"https://studomate.com/en/training/glossary#ladder","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Limit switch","alternateName":["end stop"],"description":"A sensor operated mechanically when a moving part (gate, cylinder) reaches the end of its travel.","url":"https://studomate.com/en/training/glossary#limit-switch","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Main","alternateName":["main program"],"description":"The main program of a project, run on every cycle. It calls the subprograms and cannot be excluded from execution.","url":"https://studomate.com/en/training/glossary#main","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Mnemonic","alternateName":["variable name"],"description":"The short, meaningful name of a variable (pump, stop), which programs use to refer to it. An address (%I0.1) can be added to link the variable to physical hardware.","url":"https://studomate.com/en/training/glossary#mnemonic","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Network","alternateName":["rung","section"],"description":"A block of the Ladder program, bounded by its two rails. It contains lines of contacts leading to coils. In the simplest case, a single line: contacts on the left, a coil on the right. It is read from left to right.","url":"https://studomate.com/en/training/glossary#network","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"NOT","alternateName":["inversion"],"description":"An operator that inverts a condition: true becomes false, false becomes true.","url":"https://studomate.com/en/training/glossary#not","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"OR","alternateName":["in parallel"],"description":"An operator that is true as soon as one of its conditions is true.","url":"https://studomate.com/en/training/glossary#or","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"OR divergence","alternateName":["sequence selection"],"description":"A point where the sequence splits into several paths of which only one is taken, depending on which receptivity becomes true first.","url":"https://studomate.com/en/training/glossary#or-divergence","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Output","description":"A variable written by the program to drive a lamp, a contactor, a valve or a motor.","url":"https://studomate.com/en/training/glossary#output","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Overflow","alternateName":["wrap-around"],"description":"A result that goes out of the range of its type: an INT passing 32767 wraps around to the low bound.","url":"https://studomate.com/en/training/glossary#overflow","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"PLC","alternateName":["programmable logic controller","programmable controller"],"description":"A small industrial computer that reads inputs (buttons, sensors), runs a program, then drives outputs (lamps, contactors, valves).","url":"https://studomate.com/en/training/glossary#plc","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Preset value","alternateName":["PV","preset"],"description":"The target value of a counter (PV pin). The Q output of a CTU becomes true when the count CV reaches PV.","url":"https://studomate.com/en/training/glossary#preset-value","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Push button","description":"A control device that changes state while pressed and returns to rest by itself when released.","url":"https://studomate.com/en/training/glossary#push-button","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Rails","alternateName":["left rail","right rail"],"description":"The two vertical lines framing a Ladder network: the notional current flows from the left rail to the right rail.","url":"https://studomate.com/en/training/glossary#rails","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Receptivity","alternateName":["transition condition"],"description":"The crossing condition of a transition: a true-or-false expression, such as end1 or cycle_start AND NOT stop.","url":"https://studomate.com/en/training/glossary#receptivity","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Reset","alternateName":["reinitialize","GRAFCET reset"],"description":"Put the whole GRAFCET back in its starting state: all steps inactive except the initial step, which becomes active again.","url":"https://studomate.com/en/training/glossary#reinitialize","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Retentive memory","alternateName":["retentivity"],"description":"A memory that keeps its value after a power loss or a restart, unlike an ordinary memory that restarts at 0.","url":"https://studomate.com/en/training/glossary#retentive","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Rising edge","description":"A signal going from false to true, detected during a single cycle.","url":"https://studomate.com/en/training/glossary#rising-edge","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"S and R coils","alternateName":["Set","Reset","latch","set to 1","set to 0"],"description":"An S (Set) coil sets its variable to 1 and leaves it; an R (Reset) coil sets it back to 0. Between orders, the variable keeps its value.","url":"https://studomate.com/en/training/glossary#set-reset","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Scaling","alternateName":["raw value"],"description":"A calculation that converts the raw value of an analog sensor into a physical quantity (temperature, level), usually through a straight line.","url":"https://studomate.com/en/training/glossary#scaling","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Scan cycle","alternateName":["PLC cycle","scan"],"description":"The loop a PLC repeats endlessly, in three phases: read the inputs, run the program, write the outputs.","url":"https://studomate.com/en/training/glossary#scan-cycle","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Self-holding","alternateName":["latching","seal-in"],"description":"A circuit where a contact of the coil itself is placed in parallel with the start button: the output stays on after the button is released.","url":"https://studomate.com/en/training/glossary#self-holding","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Step","description":"A numbered square representing a stable state of the system. It is active or inactive; an active step is shown with a coloured background in the editor.","url":"https://studomate.com/en/training/glossary#step","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Step variable (Xn)","alternateName":["Xn","X2"],"description":"A logic variable tied to step n: it is TRUE when the step is active (X2 = TRUE).","url":"https://studomate.com/en/training/glossary#step-variable","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Stop priority","alternateName":["start priority"],"description":"A self-holding circuit where the stop wins if start and stop are operated together. Priority depends on the order of the contacts.","url":"https://studomate.com/en/training/glossary#priority-stop","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Stored action","alternateName":["Set","Reset","Set action"],"description":"An action whose variable stays true when the step deactivates, until another action sets it back to false (Reset).","url":"https://studomate.com/en/training/glossary#set-action","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Subprogram","alternateName":["subprogram call"],"description":"A program called from another one through a call block. It lets a project be split into readable, reusable parts.","url":"https://studomate.com/en/training/glossary#subprogram","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Switch","alternateName":["maintained switch","toggle switch"],"description":"A control device that keeps its position after being operated: it stays on until switched back.","url":"https://studomate.com/en/training/glossary#switch","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"System time bases","alternateName":["_SYS_TB","system clock"],"description":"Read-only variables provided by Studomate (prefix _SYS_) that alternate between true and false at a fixed rate, from 200 ms to 2 s, for example to blink a lamp.","url":"https://studomate.com/en/training/glossary#system-time-bases","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Timer","alternateName":["timer block"],"description":"A block that measures a duration. It receives an input IN and a duration PT (the preset time), and its output Q responds according to the type: TON, TOF or TP.","url":"https://studomate.com/en/training/glossary#timer","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Timing diagram","alternateName":["chronogram"],"description":"A chart showing how several signals change over time, stacked on the same time axis.","url":"https://studomate.com/en/training/glossary#chronogram","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"TOF","alternateName":["off-delay timer"],"description":"Off-delay timer: Q becomes true as soon as IN is true and stays true for the duration PT after IN has fallen.","url":"https://studomate.com/en/training/glossary#tof","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Toggle circuit","alternateName":["latching relay","flip-flop"],"description":"A circuit where each press of a button inverts the state of an output: one press turns it on, the next turns it off.","url":"https://studomate.com/en/training/glossary#toggle","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"TON","alternateName":["on-delay timer"],"description":"On-delay timer: output Q becomes true when IN has stayed true for the whole duration PT, and falls as soon as IN falls.","url":"https://studomate.com/en/training/glossary#ton","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"TP","alternateName":["pulse timer"],"description":"Pulse timer: a rising edge on IN triggers an output Q that is true for exactly the duration PT, whatever IN does afterwards.","url":"https://studomate.com/en/training/glossary#tp","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Transition","description":"A small horizontal bar linking two steps and carrying a receptivity: the condition to meet to go from one to the other.","url":"https://studomate.com/en/training/glossary#transition","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Truth table","description":"A table giving the value of a logic expression for every combination of its variables (0 = false, 1 = true).","url":"https://studomate.com/en/training/glossary#truth-table","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Type","alternateName":["BOOL","INT","DINT","REAL","variable type"],"description":"The nature of a variable's value: BOOL (true or false), INT and DINT (16-bit and 32-bit integers), REAL (floating-point number).","url":"https://studomate.com/en/training/glossary#data-type","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Upstream, downstream","description":"Before and after, in the reading direction of the GRAFCET (top to bottom). The upstream step precedes a transition, the downstream step follows it.","url":"https://studomate.com/en/training/glossary#upstream-downstream","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Variable","description":"A named piece of data handled by the program: an input, an output or an internal memory. A logic variable is TRUE or FALSE (1 or 0).","url":"https://studomate.com/en/training/glossary#variable","inDefinedTermSet":"https://studomate.com/en/training/glossary"},{"@type":"DefinedTerm","name":"Wiring: normally open (NO) and normally closed (NC)","alternateName":["NO","NC","normally open","normally closed"],"description":"The way a button or sensor is connected. Wired normally open (NO), it is 0 at rest and 1 when operated; wired normally closed (NC), it is 1 at rest and 0 when operated.","url":"https://studomate.com/en/training/glossary#wiring","inDefinedTermSet":"https://studomate.com/en/training/glossary"}]}7:["$","$L17",null,{"maxWidth":"md","sx":{"my":4},"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$18"}}],"$L19","$L1a","$L1b"]}]
