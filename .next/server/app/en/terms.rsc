ck your inbox."},"errors":{"invalidCredentials":"Wrong email or password.","invalidPseudoCredentials":"Wrong username or password.","emailAlreadyExists":"An account already exists with this email address.","pseudoTaken":"This username is already taken. Choose another one.","emailNotConfirmed":"Your email address has not been confirmed yet. Check your inbox.","rateLimit":"Too many attempts. Please wait a few minutes before trying again.","weakPassword":"Password too weak. Use at least 8 characters.","invalidEmail":"Invalid email address.","network":"Cannot reach the server. Check your connection.","signInFailed":"Sign-in failed. Check your credentials.","signUpFailed":"Account creation failed. Please try again.","wrongPassword":"Incorrect password.","repatriationFailed":"Could not move your cloud projects to this browser. Your account has not been deleted.","deleteAccountFailed":"Account deletion failed. Please try again."},"cloudAccount":{"title":"Cloud account","projectCount":"{count, plural, one {# project in the cloud} other {# projects in the cloud}}","projectCountLoading":"Loading projects…","openProject":"Open a project","signOut":"Sign out","deleteAccount":"Delete my account"},"deleteAccount":{"title":"Delete my account","warning":"This cannot be undone: your account, your profile and your training progress will be deleted. The share links of your projects will stop working.","repatriation":"{count, plural, one {Your cloud project will be moved} other {Your # cloud projects will be moved}} to this browser before the deletion.","noCloudProjects":"Your local projects are not affected.","passwordLabel":"Confirm with your password","confirm":"Delete permanently","cancel":"Cancel","deleted":"Your account has been deleted."}},"profile":{"prompt":{"userTypeTitle":"You use Studomate as a…","userTypeHint":"Optional, to help us understand who uses the app.","schoolTypeTitle":"One last question","schoolTypeQuestion":"What kind of school do you study in?","skip":"Skip"},"fields":{"userType":"You use Studomate as a","schoolType":"Type of school","notProvided":"Not provided"},"userTypes":{"student":"Student","teacher":"Teacher / trainer","professional":"Automation professional","self_learner":"Self-learner / curious","other":"Other"},"schoolTypes":{"high_school":"High school","bts":"BTS (vocational post-secondary)","iut":"IUT / BUT (university institute of technology)","university":"University","engineering_school":"Engineering school","other":"Other"}},"whatsNew":{"title":"What's new in Studomate {version}","previous":"Previous","next":"Next","done":"Got it","slides":{"grafcetEditor":{"title":"The GRAFCET editor gets smarter","body":"Drop or move a step, a transition, an action or a step referral next to a compatible element: the link is created for you and the element snaps into place. When you move a step or a transition, its aligned actions and step referrals follow it."},"actionChains":{"title":"Chain the actions of a step","body":"An action now has a connection point on its right: link it to the next action to build a step → action → action chain. A new action chains itself after the previous one, and a moved action takes the rest of its chain along. If you delete the step, the chain stays together: link its first action to another step to reattach everything."},"scene3dDisplay":{"title":"Show the 3D scene where you want","body":"Show the 3D scene in a panel on the right of the editors, to follow the grafcet and the operative part side by side, for example when projecting. You can also open it in a floating box that you move and resize like a window, in a page of the editor or in a browser tab. The View menu and the \"3D scene\" button of the status bar open the scene in the chosen mode."}}}},"now":"$undefined","timeZone":"UTC","children":["$L1d","$L1e"]}]
