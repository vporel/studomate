7:["$","$L17",null,{"maxWidth":"md","sx":{"my":4},"children":[["$","$L18",null,{"variant":"h2","component":"h1","color":"primary","gutterBottom":true,"children":"Terms of use"}],["$","$L18",null,{"children":"Last updated: 13/10/2025"}],["$","$L19",null,{"sx":{"my":2}}],[["$","$L18",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":3,"children":"1. Purpose"}],["$","$L18",null,{"textAlign":"justify","children":[["$","$1","0",{"children":"These terms govern access to and use of "}],["$","strong","1",{"children":"Studomate"}],["$","$1","2",{"children":", a teaching application dedicated to learning, designing and simulating automated systems. The tool provides interactive spaces to represent, simulate and understand the various languages, diagrams and logic of industrial automation. By accessing Studomate, the user acknowledges having read and accepted these terms."}]]}]],[["$","$L18",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":3,"children":"2. Permitted use"}],[["$","$L18",null,{"textAlign":"justify","children":"Studomate is designed for supervised educational and professional use: teaching, training, self-learning or technical demonstration. The user agrees to:"}],["$","$L1a",null,{"component":"ul","sx":{"listStyleType":"disc","pl":4,"pt":1},"children":[["$","li","0",{"children":[["$","$1","0",{"children":"use the platform in compliance with the law and the rights of others;"}]]}],["$","li","1",{"children":[["$","$1","0",{"children":"not misuse the application for unlawful, commercial or malicious purposes;"}]]}],["$","li","2",{"children":[["$","$1","0",{"children":"not modify or attempt to access the source code without authorisation;"}]]}],["$","li","3",{"children":[["$","$1","0",{"children":"credit Studomate in any public use that incorporates it."}]]}]]}]]],[["$","$L18",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":3,"children":"3. Accounts and data"}],["$","$L18",null,{"textAlign":"justify","children":[["$","$1","0",{"children":"The current version of Studomate requires no sign-up. Projects and simulations are stored "}],["$","strong","1",{"children":"locally"}],["$","$1","2",{"children":" in "}],["$","strong","3",{"children":"files"}],["$","$1","4",{"children":". The user is responsible for backing up their files. No personal data is sent to external servers without explicit consent."}]]}]],[["$","$L18",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":3,"children":"4. Intellectual property"}],["$","$L18",null,{"textAlign":"justify","children":"All technical, graphical and conceptual content of Studomate (interface, engine, icons, structure) remains the property of its authors. Any reproduction, modification or distribution without written authorisation is prohibited. The user remains the owner of the projects and creations they develop on the platform."}]],[["$","$L18",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":3,"children":"5. Liability"}],["$","$L18",null,{"textAlign":"justify","children":"Studomate aims to make automated systems easier to understand. It is a teaching tool, not certified industrial software. No guarantee is given as to the absolute accuracy of the simulations, compatibility with real equipment or long-term data retention. Use of the application is at the user's sole responsibility."}]],[["$","$L18",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":3,"children":"6. Changes to the service"}],["$","$L18",null,{"textAlign":"justify","children":"Studomate is continuously evolving. Features may be changed, added or suspended without notice, in particular during testing or maintenance phases. The team strives to keep the service stable and transparent."}]],["$","$L18",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":3,"children":"7. Contact"}],["$","$L18",null,{"children":["For any question, suggestion or technical report:"," ",["$","$L1b",null,{"href":"/contact","children":"Get in touch."}]]}]]}]
