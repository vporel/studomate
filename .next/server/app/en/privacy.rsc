7:["$","$L17",null,{"maxWidth":"md","sx":{"my":4},"children":[["$","$L18",null,{"variant":"h2","component":"h1","color":"primary","gutterBottom":true,"children":"Privacy policy"}],["$","$L18",null,{"children":"Last updated: 31/08/2026"}],["$","$L19",null,{"sx":{"my":2}}],"$L1a",[["$","$L18",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":3,"children":"1. Introduction"}],["$","$L18",null,{"textAlign":"justify","children":[["$","$1","0",{"children":"This privacy policy describes how "}],["$","strong","1",{"children":"Studomate"}],["$","$1","2",{"children":" handles users' personal and technical data. It aims to ensure transparency and to spell out the privacy choices available."}]]}]],[["$","$L18",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":3,"children":"2. Data collected"}],["$","$L18",null,{"textAlign":"justify","children":[["$","$1","0",{"children":"Studomate collects no identifying personal data automatically. By default, the projects a user creates are stored "}],["$","strong","1",{"children":"locally"}],["$","$1","2",{"children":" in their browser and are sent to no remote server. Data leaves the user's device in only two cases, described below: audience measurement (§3) and, if they choose to create an account, accounts and cloud backup (§4)."}]]}]],[["$","$L18",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":3,"children":"3. Audience measurement"}],["$","$L18",null,{"textAlign":"justify","children":[["$","$1","0",{"children":"Studomate uses "}],["$","strong","1",{"children":"Umami"}],["$","$1","2",{"children":" (hosted in the European Union) to measure site traffic: number of visits, pages viewed, traffic sources, device type, and a few anonymous usage events (creating a project, starting a simulation). These measurements are taken "}],["$","strong","3",{"children":"without cookies"}],["$","$1","4",{"children":", without storing the IP address and without any way to identify or track a user from one visit to the next. No data is sold or used for advertising."}]]}]],[["$","$L18",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":3,"children":"4. Accounts and cloud backup"}],[["$","$L18",null,{"textAlign":"justify","children":[["$","$1","0",{"children":"Creating an account is "}],["$","strong","1",{"children":"optional"}],["$","$1","2",{"children":": without an account, Studomate runs entirely locally and no data is sent to our servers. By creating an account, a user can back up their projects to the cloud and access them on another device."}]]}],["$","$L1b",null,{"component":"ul","sx":{"listStyleType":"disc","pl":4,"pt":1},"children":[["$","li","0",{"children":[["$","$1","0",{"children":""}],["$","strong","1",{"children":"Standard account:"}],["$","$1","2",{"children":" email address and password."}]]}],["$","li","1",{"children":[["$","$1","0",{"children":""}],["$","strong","1",{"children":"Anonymous account:"}],["$","$1","2",{"children":" nickname and password, no email address."}]]}],["$","li","2",{"children":[["$","$1","0",{"children":""}],["$","strong","1",{"children":"Data stored:"}],["$","$1","2",{"children":" an account identifier, the email or nickname, and only the projects the user chooses to save to the cloud."}]]}]]}],["$","$L18",null,{"textAlign":"justify","mt":1,"children":[["$","$1","0",{"children":"This data is hosted by our processor "}],["$","strong","1",{"children":"Supabase"}],["$","$1","2",{"children":", on infrastructure located in the European Union. Each account can access only its own data (isolation enforced at the database level). No data is sold or used for advertising."}]]}]]],[["$","$L18",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":3,"children":"5. Security and confidentiality"}],["$","$L18",null,{"textAlign":"justify","children":"Studomate is committed to a high level of data protection and to never exploiting data for commercial or advertising purposes. Exchanges with the cloud are encrypted in transit (HTTPS) and access to saved projects is restricted to the account that created them. Users remain responsible for the security of files they export locally."}]],[["$","$L18",null,{"variant":"h3","component":"h2","gutterBottom":true,"mt":3,"children":"6. Cookies and local storage"}],["$","$L18",null,{"textAlign":"justify","children":"Studomate uses no tracking cookies. Only technical data is stored locally for projects to work correctly (internal identifiers, simulation states, saved settings)."}]],"$L1c","$L1d","$L1e"]}]
