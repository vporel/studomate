tPassword":{"intro":"Introduce tu dirección de correo. Recibirás un enlace para restablecer tu contraseña.","submit":"Enviar el enlace","backToSignIn":"Volver a iniciar sesión","emailSent":"Se envió un correo de restablecimiento. Revisa tu bandeja de entrada."},"errors":{"invalidCredentials":"Correo o contraseña incorrectos.","invalidPseudoCredentials":"Nombre de usuario o contraseña incorrectos.","emailAlreadyExists":"Ya existe una cuenta con esta dirección de correo.","pseudoTaken":"Este nombre de usuario ya está en uso. Elige otro.","emailNotConfirmed":"Tu dirección de correo aún no está confirmada. Revisa tu bandeja de entrada.","rateLimit":"Demasiados intentos. Espera unos minutos antes de volver a intentarlo.","weakPassword":"Contraseña demasiado débil. Usa al menos 8 caracteres.","invalidEmail":"Dirección de correo no válida.","network":"No se puede contactar con el servidor. Comprueba tu conexión.","signInFailed":"Falló el inicio de sesión. Comprueba tus credenciales.","signUpFailed":"Falló la creación de la cuenta. Inténtalo de nuevo.","wrongPassword":"Contraseña incorrecta.","repatriationFailed":"No se pudieron mover tus proyectos de la nube a este navegador. Tu cuenta no se ha eliminado.","deleteAccountFailed":"Falló la eliminación de la cuenta. Inténtalo de nuevo."},"cloudAccount":{"title":"Cuenta en la nube","projectCount":"{count, plural, one {# proyecto en la nube} other {# proyectos en la nube}}","projectCountLoading":"Cargando proyectos…","openProject":"Abrir un proyecto","signOut":"Cerrar sesión","deleteAccount":"Eliminar mi cuenta"},"deleteAccount":{"title":"Eliminar mi cuenta","warning":"Esta acción no se puede deshacer: se eliminarán tu cuenta, tu perfil y tu progreso en la formación. Los enlaces para compartir tus proyectos dejarán de funcionar.","repatriation":"{count, plural, one {Tu proyecto en la nube se moverá} other {Tus # proyectos en la nube se moverán}} a este navegador antes de la eliminación.","noCloudProjects":"Tus proyectos locales no se ven afectados.","passwordLabel":"Confirma con tu contraseña","confirm":"Eliminar definitivamente","cancel":"Cancelar","deleted":"Tu cuenta ha sido eliminada."}},"profile":{"prompt":{"userTypeTitle":"Usas Studomate como…","userTypeHint":"Opcional, para ayudarnos a entender quién usa la aplicación.","schoolTypeTitle":"Una última pregunta","schoolTypeQuestion":"¿En qué tipo de centro estudias?","skip":"Omitir"},"fields":{"userType":"Usas Studomate como","schoolType":"Tipo de centro","notProvided":"No indicado"},"userTypes":{"student":"Estudiante","teacher":"Docente / formador","professional":"Profesional de la automatización","self_learner":"Autodidacta / curioso","other":"Otro"},"schoolTypes":{"high_school":"Instituto (secundaria)","bts":"BTS (formación profesional superior, Francia)","iut":"IUT / BUT (instituto universitario de tecnología, Francia)","university":"Universidad","engineering_school":"Escuela de ingeniería","other":"Otro"}},"whatsNew":{"title":"Novedades de Studomate {version}","previous":"Anterior","next":"Siguiente","done":"Entendido","slides":{"spanishLanguage":{"title":"Studomate ahora habla español","body":"La interfaz de la aplicación, el manual de usuario, la formación y las páginas del sitio ya están disponibles en español. Elige el idioma en Archivo → Preferencias o con el selector de idioma de las páginas del sitio. Un proyecto creado en español usa las palabras clave de expresión de la IEC 61131-3 (AND, OR, NOT)."},"imageExport":{"title":"Exporte sus programas como imagen","body":"Los grafcets y los ladders ahora se pueden exportar a PNG o SVG, además de a PDF. El botón \"Exportar\" de la barra de herramientas ofrece el formato que prefiera, y la pestaña \"Exportar imagen\" de la ventana de exportación permite exportar varios programas a la vez. Un ladder grande se divide en imágenes A4 horizontales, agrupadas con las demás en un archivo ZIP."}}}},"now":"$undefined","timeZone":"UTC","children":["$L1a","$L1b"]}]
18:["$","$L19",null,{"formats":"$undefined","locale":"es","messages":{"public":{"landing":{"heroTitle":"Aprende GRAFCET y Ladder<br></br>simulándolos","heroTagline":"Diseña, simula y prueba tu lógica de automatización con HMI animadas, directamente en tu navegador.","heroBadges":"Gratuito y de código abierto · Sin instalación · Sin cuenta · Sin datos personales","heroSceneLabel":"Animación 3D de una estación de clasificación de cajas: una cinta transportadora trae cada caja y unos cilindros la clasifican según su altura.","followTraining":"Seguir el curso","showcaseGrafcetAlt":"El editor de Studomate simulando un GRAFCET","showcaseLadderAlt":"El editor de Studomate simulando un diagrama Ladder","showcaseHmiAlt":"El editor de HMI de Studomate","demoTitle":"Mira Studomate en acción","demoVideoLabel":"Demostración de cómo crear y simular un proyecto con Studomate","demoVideoPause":"Pausar la demostración","demoVideoPlay":"Reproducir la demostración","logicTitle":"Escribe la lógica","logicIntro":"GRAFCET y Ladder en el mismo proyecto, con las mismas variables compartidas.","machineTitle":"Controla la máquina","machineIntro":"Conecta tu programa a una HMI, a una escena 3D o a una placa Arduino real.","showcaseGrafcetTitle":"GRAFCET","showcaseGrafcetText":"Dibuja etapas, transiciones y ramas, y sigue el GRAFCET mientras se ejecuta: etapas activas, condiciones verdaderas, acciones en curso.","showcaseLadderTitle":"Ladder","showcaseLadderText":"Construye redes con contactos, bobinas, temporizadores y contadores, y observa cómo circula la corriente durante la simulación.","showcaseHmiTitle":"HMI","showcaseHmiText":"Crea páginas de supervisión animadas (luces, pulsadores, depósitos, objetos en movimiento) ligadas a las mismas variables que tus programas.","showcaseScene3dTitle":"Escenas 3D","showcaseScene3dText":"Conecta tu programa a una planta 3D virtual (cintas, cilindros, sensores) y observa cómo responde la máquina en tiempo real.","showcaseScene3dAlt":"Escena 3D de una estación de clasificación de cajas controlada por Studomate","showcaseArduinoTitle":"Arduino","showcaseArduinoText":"Carga tu programa en una placa Arduino Uno R3 real, o usa sus entradas y salidas durante la simulación, directamente desde Chrome o Edge.","showcaseArduinoAlt":"Placa Arduino Uno R3","whyTitle":"¿Por qué Studomate?","whyIntro":"Studomate existe para reducir casi a cero la fricción al aprender automatización.","reasonFrictionTitle":"Cero fricción","reasonFrictionText":"Sin instalación, sin licencia, sin PLC ni tarjetas de E/S que configurar. Te centras en la lógica, no en la herramienta.","reasonAllInOneTitle":"Todo en uno","reasonAllInOneText":"GRAFCET, Ladder y HMI animadas en el mismo entorno, con variables compartidas entre las tres. Ninguna herramienta gratuita combina las tres.","reasonShortLoopTitle":"Ciclo de corrección corto","reasonShortLoopText":"Los errores se señalan mientras editas, no solo al iniciar la simulación. Un derecho a equivocarse, rápido y visual.","audienceStudents":"Estudiantes (formación profesional, escuelas de ingeniería, universidades)","audienceTeachers":"Docentes y formadores de automatización / electricidad","audienceProfessionals":"Profesionales que se reciclan o repasan","featureSimulationTitle":"Simulación en tiempo real","featureSimulationText":"Ejecución paso a paso o continua, con visualización en directo de estados, transiciones y variables.","featureManualTitle":"Manual integrado","featureManualText":"Ayuda completa disponible desde la propia aplicación.","featureCloudTitle":"Cuentas y nube (opcional)","featureCloudText":"Proyectos guardados en local o en la nube, con uso compartido mediante enlace.","stepsTitle":"Empieza en 30 segundos","step1Title":"Abre la aplicación","step1Text":"Nada que instalar: todo funciona en el navegador.","step2Title":"Crea un proyecto o parte de un ejemplo","step2Text":"Empieza desde cero o abre una de las plantillas ya preparadas.","step3Title":"Analiza y luego simula","step3Text":"Comprueba la estructura, ejecuta la lógica y observa cómo reacciona el sistema.","trainingTitle":"Aprende automatización industrial con Studomate","trainingIntro":"Módulos guiados para dominar GRAFCET y después Ladder, con ejercicios que puedes simular en la aplicación.","trainingA0LinkLabel":"Fundamentos de automatización","trainingA0Topic":"Fundamentos","trainingA0Summary":"Automatización, variables, lógica básica y ciclo de escaneo.","trainingA1LinkLabel":"Fundamentos de GRAFCET","trainingA1Topic":"GRAFCET","trainingA1Summary":"Etapas, transiciones, acciones, ramas en O y en Y.","trainingA2LinkLabel":"Lógica Ladder y memoria","trainingA2Topic":"Ladder","trainingA2Summary":"Contactos, bobinas, autorretención, bobinas set/reset y flancos.","trainingA3LinkLabel":"Temporizadores, contadores y cálculo en Ladder","trainingA3Topic":"Ladder","trainingA3Summary":"Temporizadores, contadores, cálculos y subprogramas.","trainingA4LinkLabel":"Del GRAFCET a la lógica Ladder (parte 1)","trainingA4Topic":"GRAFCET → Ladder","trainingA4Summary":"Implementar un GRAFCET en Ladder: una red por transición, dos programas, acciones, tiempo y fallos.","trainingA5LinkLabel":"Del GRAFCET a la lógica Ladder (parte 2)","trainingA5Topic":"GRAFCET → Ladder (continuación)","trainingA5Summary":"Divergencias en O y en Y, parada de una secuencia, límites de una red por transición y método de los tres bloques.","trainingCta":"Ver toda la formación","templatesTitle":"Ejemplos para empezar","templatesIntro":"Abre un proyecto ya configurado y explóralo a tu ritmo.","templatePreviewAlt":"Vista previa del proyecto {label}","openInApp":"Abrir en la aplicación","durabilityTitle":"Tus proyectos son tuyos","durabilityNoLockInTitle":"Sin dependencia","durabilityNoLockInText":"Tus proyectos son archivos que exportas y conservas. El esquema está versionado: un proyecto exportado hoy seguirá abriéndose después de actualizar la herramienta.","durabilityIndependenceTitle":"No dependes de nadie","durabilityIndependenceText":"El código es libre bajo la licencia AGPL v3: si el proyecto se detiene, se puede bifurcar o alojar por cuenta propia.","privacyTitle":"Pensado para la privacidad","privacyText":"Sin correo obligatorio, sin datos personales almacenados, sin cookies de seguimiento. La autenticación usa un alias y las estadísticas de uso son anónimas.","sourceCodeText":"El código fuente es público: léelo, informa de un problema o contribuye.","viewOnGitHub":"Ver en GitHub","openApp":"Abrir la aplicación"}},"templates":{"traffic-light":{"label":"Semáforo","description":"3 salidas booleanas (rojo, ámbar, verde) + una HMI con indicadores de color. Por programar."},"crossroads":{"label":"Cruce con semáforos","description":"12 salidas booleanas (rojo/ámbar/verde × 4 semáforos: NS1, NS2, EO1, EO2) + una HMI con el cruce. Planta simulada por la escena 3D. Por programar."},"drilling":{"label":"Estación de taladrado","description":"Ciclo secuencial gobernado por finales de carrera: pulsador de marcha, descenso, taladrado temporizado, subida. Consola y planta simuladas por la escena 3D. Por programar."},"elevator":{"label":"Ascensor","description":"Ascensor de 3 plantas: botones de llamada y de cabina, indicador de planta y lámparas en la escena 3D que simula la planta. Por programar."},"parking":{"label":"Aparcamiento con barreras","description":"Dos barreras (entrada y salida) y un contador de plazas: sensores de coche en espera, una fotocélula bajo la barrera, una lámpara de «completo» y un contador en la escena 3D, donde los botones Llegada y Salida traen coches. Por programar."},"carton-sorting":{"label":"Estación de clasificación de cajas","description":"Clasificación de cajas por altura: detección en el puesto, desvío con tres cilindros hacia dos cintas de salida, conteo. Planta simulada por la escena 3D. Por programar."},"linear-sequence":{"label":"Secuencia lineal","description":"Un GRAFCET de 4 etapas, una sola cadena, sin temporización ni divergencia. Miniejercicio del módulo de formación."},"and-divergence":{"label":"Divergencia en Y","description":"Una divergencia en Y cerrada por su convergencia, dos ramas paralelas. Miniejercicio del módulo de formación."},"or-divergence":{"label":"Divergencia en O","description":"Una divergencia en O de dos ramas mutuamente excluyentes, cada una de las cuales vuelve por sí sola al estado inicial. Miniejercicio del módulo de formación."},"timer-cycle":{"label":"Temporizador","description":"Un GRAFCET de 2 etapas que alterna según dos temporizaciones, sin entradas. Observación del módulo de formación."},"ladder-and-or":{"label":"Contactos en serie y en paralelo","description":"Dos redes proporcionadas: cambia a y b en simulación para observar AND y OR. Miniejercicio del módulo de formación."},"ladder-reading":{"label":"Leer un programa Ladder","description":"Cuatro redes combinacionales proporcionadas: predice las salidas y compruébalas en simulación. Miniejercicio del módulo de formación."},"ladder-logic":{"label":"Iluminación conmutada","description":"Lógica combinacional: dos interruptores y una habilitación. Miniejercicio del módulo de formación."},"ladder-self-holding":{"label":"Bomba: autorretención","description":"Arranque por pulsador, prioridad de paro, autorretención. Miniejercicio del módulo de formación."},"ladder-interlock":{"label":"Motor con inversión de giro","description":"Dos autorretenciones enclavadas entre sí con un paro común. Miniejercicio del módulo de formación."},"ladder-memory":{"label":"Bomba: fallo memorizado","description":"Relé térmico, lámpara de fallo memorizado, rearme sin reinicio automático. Miniejercicio del módulo de formación."},"ladder-edges-reading":{"label":"Leer flancos","description":"La misma entrada en un contacto NO, P y N: registra el cronograma. Miniejercicio del módulo de formación."},"ladder-toggle":{"label":"Telerruptor","description":"Un botón enciende y luego apaga una lámpara: orden de ejecución de las redes y contacto P. Miniejercicio del módulo de formación."},"ladder-gate":{"label":"Portón motorizado","description":"Dos sentidos enclavados, finales de carrera, paro, fotocélula. El estudiante declara las entradas. Síntesis del módulo de formación."},"ladder-timers-reading":{"label":"Leer temporizadores","description":"Un TON, un TOF y un TP sobre la misma entrada: dibuja los cronogramas. Miniejercicio del módulo de formación."},"ladder-timers":{"label":"Arranque estrella-triángulo","description":"Estrella y luego triángulo con un TON, ventilador mantenido por un TOF, intermitente con dos TON. Miniejercicio del módulo de formación."},"ladder-counters":{"label":"Conteo","description":"Conteo de piezas (CTU), zona de almacenamiento intermedio (CTUD), stock (CTD). Miniejercicio del módulo de formación."},"ladder-tank":{"label":"Depósito","description":"Histéresis de nivel, alarma, contador de arranques con un contacto P. Miniejercicio del módulo de formación."},"ladder-scaling":{"label":"Escalado","description":"Cálculo de un nivel a partir de un valor bruto: desbordamiento, truncamiento, cálculo en REAL. Miniejercicio del módulo de formación."},"ladder-subprograms":{"label":"Subprogramas","description":"Llama al subprograma de conteo desde el Main y observa el efecto de una llamada condicional. Miniejercicio del módulo de formación."},"ladder-packing":{"label":"Encajado de cajas","description":"Cinta, fallo, conteo y cambio de caja en subprogramas. Sin variables proporcionadas. Síntesis del módulo de formación."},"linear-sequence-naive-ladder":{"label":"Secuencia lineal: método de manual","description":"GRAFCET lineal implementado con una autorretención por etapa: observa el solapamiento. Miniejercicio del módulo de formación."},"linear-sequence-ladder":{"label":"Secuencia lineal en Ladder","description":"Implementa un GRAFCET lineal en Ladder, una red por transición. Miniejercicio del módulo de formación."},"drilling-ladder":{"label":"Estación de taladrado en Ladder","description":"GRAFCET de taladrado en Ladder, temporizador y vigilancia del descenso. Síntesis del módulo de formación."},"or-divergence-ladder":{"label":"Divergencia en O en Ladder","description":"Una divergencia en O implementada en Ladder. Miniejercicio del módulo de formación."},"and-divergence-ladder":{"label":"Divergencia en Y en Ladder","description":"Una divergencia en Y implementada en Ladder. Miniejercicio del módulo de formación."},"traffic-light-ladder":{"label":"Semáforo en Ladder","description":"Semáforo en Ladder con reinicio y paro al final del ciclo. Miniejercicio del módulo de formación."},"parking-ladder":{"label":"Aparcamiento en Ladder","description":"Control de un aparcamiento en Ladder, señalización proporcionada, reinicio. Síntesis del módulo de formación."},"gate-per-transition-ladder":{"label":"Portón con mando a distancia: una red por transición","description":"Portón de un solo botón implementado con una red por transición. Ejemplo del módulo de formación."},"gate-grafcet-ladder":{"label":"Portón con mando a distancia: tres bloques","description":"Portón de un solo botón implementado en tres bloques. Ejemplo del módulo de formación."}}},"now":"$undefined","timeZone":"UTC","children":"$L1c"}]
