# Environnement de déploiement : `dev` ou `prod`. En `dev`, Sentry et Umami
# sont désactivés quelles que soient leurs variables. Préfixe `NEXT_PUBLIC_`
# requis : lu côté navigateur.
NEXT_PUBLIC_APP_ENV=dev

# URL publique du site — sert de metadataBase pour les URLs absolues des métadonnées
# de partage social (Open Graph, Twitter). Sans elle, un fallback est utilisé.
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_SUPABASE_URL= 
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — remontée d'erreurs (optionnel en dev, requis en production)
# Créer un projet sur https://sentry.io et copier le DSN ici
NEXT_PUBLIC_SENTRY_DSN=

# Umami — mesure d'audience sans cookie (optionnel). Sans ces deux variables,
# aucun script d'analytics n'est chargé.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
